{
  "name": "@remit/mailbox-service",
  "version": "0.0.1",
  "type": "module",
  "main": "src/index.ts",
  "types": "src/index.ts",
  "exports": {
    ".": {
      "types": "./src/index.ts",
      "default": "./src/index.ts"
    },
    "./filter-config": {
      "types": "./src/filters/filter-config.ts",
      "default": "./src/filters/filter-config.ts"
    },
    "./body-sync-queue": {
      "types": "./src/body-sync-queue.ts",
      "default": "./src/body-sync-queue.ts"
    },
    "./imapflow-connection": {
      "types": "./src/imapflow-connection.ts",
      "default": "./src/imapflow-connection.ts"
    },
    "./account-credentials": {
      "types": "./src/account-credentials.ts",
      "default": "./src/account-credentials.ts"
    },
    "./outbox-attachment-content": {
      "types": "./src/outbox-attachment-content.ts",
      "default": "./src/outbox-attachment-content.ts"
    },
    "./types": {
      "types": "./src/types.ts",
      "default": "./src/types.ts"
    },
    "./test-helpers/fake-imap": {
      "types": "./src/test-helpers/fake-imap.ts",
      "default": "./src/test-helpers/fake-imap.ts"
    },
    "./test-helpers/test-queue": {
      "types": "./src/test-helpers/test-queue.ts",
      "default": "./src/test-helpers/test-queue.ts"
    },
    "./test-helpers/test-store": {
      "types": "./src/test-helpers/test-store.ts",
      "default": "./src/test-helpers/test-store.ts"
    }
  },
  "scripts": {
    "test:typecheck": "tsgo --noEmit",
    "test:run": "node $NODE_TEST_FLAGS --env-file=../../localhost-test-unit.env --import tsx --experimental-test-coverage --test-coverage-include='src/**' --test-coverage-exclude='src/**/*.test.ts' --test-coverage-exclude='src/**/*.test.tsx' --test-coverage-lines=86 --test 'src/**/*.test.ts'",
    "test": "npm run test:typecheck && npm run test:run"
  },
  "devDependencies": {
    "@remit/drizzle-service": "*",
    "@types/better-sqlite3": "^7.6.13",
    "aws-sdk-client-mock": "*",
    "better-sqlite3": "^12.11.1"
  },
  "dependencies": {
    "imapflow": "^1.3.3",
    "mailparser": "3.12.2",
    "nodemailer": "^10.0.6",
    "p-map": "^7.0.4",
    "tldts": "^7.4.9",
    "@remit/data-ports": "*",
    "@remit/domain-enums": "*",
    "@remit/mail-oauth-service": "*",
    "@remit/secrets-service": "*",
    "@remit/sqs-client": "*",
    "@remit/storage-service": "*",
    "@aws-sdk/client-sqs": "*",
    "franc": "*",
    "natural": "^8.1.1",
    "stopword": "*",
    "@types/mailparser": "*",
    "@types/nodemailer": "*",
    "@types/stopword": "^2.0.3",
    "@remit/calendar-service": "*"
  },
  "license": "MIT",
  "publishConfig": {
    "access": "public"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/remit-mail/reader.git",
    "directory": "packages/mailbox-service"
  }
}
