{
  "name": "@remit/mailbox-service",
  "version": "0.0.1",
  "type": "module",
  "main": "src/index.ts",
  "types": "src/index.ts",
  "exports": {
    ".": {
      "types": "./src/index.ts",
      "default": "./src/index.ts"
    },
    "./filter-config": {
      "types": "./src/filters/filter-config.ts",
      "default": "./src/filters/filter-config.ts"
    },
    "./body-sync-queue": {
      "types": "./src/body-sync-queue.ts",
      "default": "./src/body-sync-queue.ts"
    },
    "./imapflow-connection": {
      "types": "./src/imapflow-connection.ts",
      "default": "./src/imapflow-connection.ts"
    },
    "./node-transport": {
      "types": "./src/node-transport.ts",
      "default": "./src/node-transport.ts"
    },
    "./account-credentials": {
      "types": "./src/account-credentials.ts",
      "default": "./src/account-credentials.ts"
    },
    "./outbox-attachment-content": {
      "types": "./src/outbox-attachment-content.ts",
      "default": "./src/outbox-attachment-content.ts"
    },
    "./types": {
      "types": "./src/types.ts",
      "default": "./src/types.ts"
    },
    "./test-helpers/fake-imap": {
      "types": "./src/test-helpers/fake-imap.ts",
      "default": "./src/test-helpers/fake-imap.ts"
    },
    "./test-helpers/test-store": {
      "types": "./src/test-helpers/test-store.ts",
      "default": "./src/test-helpers/test-store.ts"
    }
  },
  "scripts": {
    "prepack": "node ../../npm-scripts/pack-dist.mjs prepack",
    "postpack": "node ../../npm-scripts/pack-dist.mjs postpack",
    "test:typecheck": "tsgo --noEmit",
    "test:run": "node $NODE_TEST_FLAGS --env-file=../../localhost-test-unit.env --import tsx --experimental-test-coverage --test-coverage-include='src/**' --test-coverage-exclude='src/**/*.test.ts' --test-coverage-exclude='src/**/*.test.tsx' --test-coverage-lines=86 --test 'src/**/*.test.ts'",
    "test": "npm run test:typecheck && npm run test:run"
  },
  "devDependencies": {
    "@remit/drizzle-service": "*",
    "@types/better-sqlite3": "^7.6.13",
    "better-sqlite3": "^12.11.1"
  },
  "dependencies": {
    "imapflow": "^2.9.1",
    "mailparser": "3.12.2",
    "p-map": "^7.0.4",
    "async-mutex": "0.5.0",
    "tldts": "^7.4.9",
    "@remit/data-ports": "*",
    "@remit/domain-enums": "*",
    "@remit/mail-oauth-service": "*",
    "@remit/secrets-service": "*",
    "@remit/storage-service": "*",
    "franc": "^6.2.0",
    "natural": "^8.1.1",
    "stopword": "^3.1.5",
    "@types/mailparser": "^3.4.6",
    "@types/stopword": "^2.0.3",
    "@remit/calendar-service": "*"
  },
  "license": "MIT",
  "publishConfig": {
    "access": "public"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/remit-mail/reader.git",
    "directory": "packages/mailbox-service"
  },
  "packManifest": {
    "main": "dist/index.js",
    "types": "dist/index.d.ts",
    "exports": {
      ".": {
        "types": "./dist/index.d.ts",
        "default": "./dist/index.js"
      },
      "./filter-config": {
        "types": "./dist/filters/filter-config.d.ts",
        "default": "./dist/filters/filter-config.js"
      },
      "./body-sync-queue": {
        "types": "./dist/body-sync-queue.d.ts",
        "default": "./dist/body-sync-queue.js"
      },
      "./imapflow-connection": {
        "types": "./dist/imapflow-connection.d.ts",
        "default": "./dist/imapflow-connection.js"
      },
      "./node-transport": {
        "types": "./dist/node-transport.d.ts",
        "default": "./dist/node-transport.js"
      },
      "./account-credentials": {
        "types": "./dist/account-credentials.d.ts",
        "default": "./dist/account-credentials.js"
      },
      "./outbox-attachment-content": {
        "types": "./dist/outbox-attachment-content.d.ts",
        "default": "./dist/outbox-attachment-content.js"
      },
      "./types": {
        "types": "./dist/types.d.ts",
        "default": "./dist/types.js"
      },
      "./test-helpers/fake-imap": {
        "types": "./dist/test-helpers/fake-imap.d.ts",
        "default": "./dist/test-helpers/fake-imap.js"
      },
      "./test-helpers/test-store": {
        "types": "./dist/test-helpers/test-store.d.ts",
        "default": "./dist/test-helpers/test-store.js"
      }
    },
    "files": [
      "dist"
    ]
  }
}
