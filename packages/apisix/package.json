{
	"name": "@remit/apisix",
	"version": "0.0.1",
	"private": true,
	"type": "module",
	"description": "APISIX edge route table, generated from the OpenAPI spec and baked into the apisix image.",
	"exports": {
		"./route-table": "./src/route-table.ts"
	},
	"scripts": {
		"generate": "node --import tsx generate-config.ts",
		"test:typecheck": "tsgo --noEmit",
		"test:run": "node $NODE_TEST_FLAGS --import tsx --experimental-test-coverage --test-coverage-include='src/**' --test-coverage-exclude='src/**/*.test.ts' --test-coverage-lines=95 --test 'src/**/*.test.ts'",
		"test": "npm run test:typecheck && npm run test:run"
	},
	"dependencies": {
		"@remit/auth-service": "*"
	},
	"license": "MIT",
	"devDependencies": {
		"yaml": "^2.8.4",
		"zod": "^4.6.7"
	}
}
