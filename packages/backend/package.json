{
  "name": "@remit/backend",
  "version": "0.0.1",
  "description": "Remit Mail Inspector API backend",
  "license": "MIT",
  "author": "",
  "type": "module",
  "main": "src/index.ts",
  "exports": {
    ".": {
      "types": "./src/index.ts",
      "default": "./src/index.ts"
    },
    "./api": {
      "types": "./src/api.ts",
      "default": "./src/api.ts"
    },
    "./serve": {
      "types": "./src/serve.ts",
      "default": "./src/serve.ts"
    },
    "./client": {
      "types": "./src/service/data-client.ts",
      "default": "./src/service/data-client.ts"
    },
    "./create-remit-client": {
      "types": "./src/service/create-remit-client.ts",
      "default": "./src/service/create-remit-client.ts"
    },
    "./shared-deps": {
      "types": "./src/service/shared-deps.ts",
      "default": "./src/service/shared-deps.ts"
    },
    "./compose-sqlite": {
      "types": "./src/service/compose-sqlite.ts",
      "default": "./src/service/compose-sqlite.ts"
    },
    "./folder-role-appointments": {
      "types": "./src/handlers/folder-role-appointments.ts",
      "default": "./src/handlers/folder-role-appointments.ts"
    },
    "./folder-role-labels": {
      "types": "./src/handlers/folder-role-labels.ts",
      "default": "./src/handlers/folder-role-labels.ts"
    },
    "./organize": {
      "types": "./src/service/organize.ts",
      "default": "./src/service/organize.ts"
    },
    "./sender-category": {
      "types": "./src/service/sender-category.ts",
      "default": "./src/service/sender-category.ts"
    },
    "./account-deletion": {
      "types": "./src/service/account-deletion.ts",
      "default": "./src/service/account-deletion.ts"
    },
    "./trigger-sync": {
      "types": "./src/service/trigger-sync.ts",
      "default": "./src/service/trigger-sync.ts"
    },
    "./content-handler": {
      "types": "./dev-server/content-handler.ts",
      "default": "./dev-server/content-handler.ts"
    }
  },
  "packManifest": {
    "main": "dist/src/index.js",
    "types": "dist/src/index.d.ts",
    "exports": {
      ".": {
        "types": "./dist/src/index.d.ts",
        "default": "./dist/src/index.js"
      },
      "./api": {
        "types": "./dist/src/api.d.ts",
        "default": "./dist/src/api.js"
      },
      "./serve": {
        "types": "./dist/src/serve.d.ts",
        "default": "./dist/src/serve.js"
      },
      "./client": {
        "types": "./dist/src/service/data-client.d.ts",
        "default": "./dist/src/service/data-client.js"
      },
      "./create-remit-client": {
        "types": "./dist/src/service/create-remit-client.d.ts",
        "default": "./dist/src/service/create-remit-client.js"
      },
      "./shared-deps": {
        "types": "./dist/src/service/shared-deps.d.ts",
        "default": "./dist/src/service/shared-deps.js"
      },
      "./compose-sqlite": {
        "types": "./dist/src/service/compose-sqlite.d.ts",
        "default": "./dist/src/service/compose-sqlite.js"
      },
      "./folder-role-appointments": {
        "types": "./dist/src/handlers/folder-role-appointments.d.ts",
        "default": "./dist/src/handlers/folder-role-appointments.js"
      },
      "./folder-role-labels": {
        "types": "./dist/src/handlers/folder-role-labels.d.ts",
        "default": "./dist/src/handlers/folder-role-labels.js"
      },
      "./organize": {
        "types": "./dist/src/service/organize.d.ts",
        "default": "./dist/src/service/organize.js"
      },
      "./sender-category": {
        "types": "./dist/src/service/sender-category.d.ts",
        "default": "./dist/src/service/sender-category.js"
      },
      "./account-deletion": {
        "types": "./dist/src/service/account-deletion.d.ts",
        "default": "./dist/src/service/account-deletion.js"
      },
      "./trigger-sync": {
        "types": "./dist/src/service/trigger-sync.d.ts",
        "default": "./dist/src/service/trigger-sync.js"
      },
      "./content-handler": {
        "types": "./dist/dev-server/content-handler.d.ts",
        "default": "./dist/dev-server/content-handler.js"
      }
    },
    "files": [
      "dist"
    ]
  },
  "scripts": {
    "prepack": "node ../../npm-scripts/pack-dist.mjs prepack",
    "postpack": "node ../../npm-scripts/pack-dist.mjs postpack",
    "test:typecheck": "tsgo --noEmit",
    "test:run": "node $NODE_TEST_FLAGS --env-file .env.test --import tsx --experimental-test-coverage --test-coverage-include='src/**' --test-coverage-exclude='src/**/*.test.ts' --test-coverage-exclude='src/**/*.test.tsx' --test-coverage-lines=76 --test 'src/**/*.test.ts' 'dev-server/**/*.test.ts'",
    "test": "npm run test:typecheck && npm run test:run",
    "bundle": "esbuild 'src/index.ts' --sourcemap --bundle --platform=node --outfile=dist/index.js",
    "dev": "node --env-file .env.test --watch --import tsx dev-server/server.ts",
    "dev:remote": "node --env-file ../../.env.dev --watch --import tsx dev-server/server.ts",
    "serve": "node --import tsx dev-server/server.ts"
  },
  "devDependencies": {
    "@remit/apisix": "*",
    "@types/better-sqlite3": "^7.6.13",
    "@types/express": "^5.0.3",
    "@types/swagger-ui-express": "^4.1.8",
    "better-sqlite3": "^12.11.1",
    "esbuild": "^0.28.1",
    "express": "^5.1.0",
    "swagger-ui-express": "^5.0.1",
    "tsx": "*"
  },
  "dependencies": {
    "@remit/config-format": "*",
    "@remit/config-transfer": "*",
    "@remit/calendar-service": "*",
    "@remit/data-ports": "*",
    "@remit/domain-enums": "*",
    "@remit/api-openapi-types": "*",
    "@remit/logger-lambda": "*",
    "@remit/mail-oauth-service": "*",
    "@remit/secrets-service": "*",
    "@remit/mailbox-service": "*",
    "@remit/storage-service": "*",
    "@remit/auth-service": "*",
    "@remit/drizzle-service": "*",
    "@remit/sqs-client": "*",
    "@aws-sdk/client-secrets-manager": "^3.1090.0",
    "better-sqlite3": "^12.11.1",
    "expect-env": "^1.0.1",
    "openapi-backend": "^5.18.0",
    "p-map": "^2.1.0",
    "@types/aws-lambda": "^8.10.162",
    "@types/better-sqlite3": "^7.6.13",
    "@remit/logger": "*",
    "@remit/api-openapi-spec": "*",
    "zod": "^3.25.0"
  },
  "publishConfig": {
    "access": "public"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/remit-mail/reader.git",
    "directory": "packages/backend"
  }
}
