{
  "name": "@remit/drizzle-service",
  "version": "0.0.1",
  "description": "Drizzle ORM service over SQLite",
  "type": "module",
  "main": "src/index.ts",
  "types": "src/index.ts",
  "exports": {
    ".": {
      "types": "./src/index.ts",
      "default": "./src/index.ts"
    },
    "./sqlite": {
      "types": "./src/sqlite.ts",
      "default": "./src/sqlite.ts"
    },
    "./test-sqlite": {
      "types": "./src/test-sqlite.ts",
      "default": "./src/test-sqlite.ts"
    },
    "./schema-sets/mcp": {
      "types": "./src/schema-sets/mcp.ts",
      "default": "./src/schema-sets/mcp.ts"
    }
  },
  "scripts": {
    "test:typecheck": "tsgo --noEmit -p tsconfig.json",
    "test:run": "node $NODE_TEST_FLAGS --env-file=../../localhost-test-unit-sqlite.env --import tsx --experimental-test-coverage --test-coverage-include='src/**' --test-coverage-exclude='src/**/*.test.ts' --test-coverage-exclude='src/**/*.test.tsx' --test-coverage-lines=90 --test 'src/**/*.test.ts'",
    "test": "npm run test:typecheck && npm run test:run",
    "fix": "biome check --write src"
  },
  "devDependencies": {
    "@remit/calendar-service": "*",
    "@remit/config-transfer": "*",
    "drizzle-kit": "1.0.0-rc.5",
    "miniflare": "^4.20260730.0",
    "tsx": "*"
  },
  "dependencies": {
    "@remit/data-ports": "*",
    "@remit/domain-enums": "*",
    "drizzle-orm": "1.0.0-rc.5",
    "uuid": "^13.0.2",
    "@remit/drizzle-sqlite-schema": "*",
    "@remit/storage-service": "*",
    "p-map": "^2.1.0"
  },
  "license": "MIT",
  "publishConfig": {
    "access": "public"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/remit-mail/reader.git",
    "directory": "packages/drizzle-service"
  }
}
