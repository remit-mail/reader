{
	"name": "@remit/storage-service",
	"version": "0.0.1",
	"type": "module",
	"main": "src/index.ts",
	"types": "src/index.ts",
	"exports": {
		".": {
			"types": "./src/index.ts",
			"default": "./src/index.ts"
		},
		"./filesystem": {
			"types": "./src/filesystem.ts",
			"default": "./src/filesystem.ts"
		},
		"./s3": {
			"types": "./src/s3.ts",
			"default": "./src/s3.ts"
		},
		"./signed-path": {
			"types": "./src/signed-path.ts",
			"default": "./src/signed-path.ts"
		}
	},
	"packManifest": {
		"main": "dist/index.js",
		"types": "dist/index.d.ts",
		"exports": {
			".": {
				"types": "./dist/index.d.ts",
				"default": "./dist/index.js"
			},
			"./filesystem": {
				"types": "./dist/filesystem.d.ts",
				"default": "./dist/filesystem.js"
			},
			"./s3": {
				"types": "./dist/s3.d.ts",
				"default": "./dist/s3.js"
			},
			"./signed-path": {
				"types": "./dist/signed-path.d.ts",
				"default": "./dist/signed-path.js"
			}
		},
		"files": [
			"dist"
		]
	},
	"scripts": {
		"prepack": "node ../../npm-scripts/pack-dist.mjs prepack",
		"postpack": "node ../../npm-scripts/pack-dist.mjs postpack",
		"test:typecheck": "tsgo --noEmit",
		"test:run": "node $NODE_TEST_FLAGS --env-file=../../localhost-test-unit.env --import tsx --experimental-test-coverage --test-coverage-include='src/**' --test-coverage-exclude='src/**/*.test.ts' --test-coverage-exclude='src/**/*.test.tsx' --test-coverage-lines=87 --test 'src/**/*.test.ts'",
		"test": "npm run test:typecheck && npm run test:run"
	},
	"dependencies": {
		"@aws-sdk/client-s3": "^3.1090.0",
		"@aws-sdk/lib-storage": "^3.1090.0",
		"@aws-sdk/s3-request-presigner": "^3.1090.0",
		"@remit/domain-enums": "*"
	},
	"devDependencies": {
		"aws-sdk-client-mock": "*"
	},
	"license": "MIT",
	"publishConfig": {
		"access": "public"
	},
	"repository": {
		"type": "git",
		"url": "git+https://github.com/remit-mail/reader.git",
		"directory": "packages/storage-service"
	}
}
