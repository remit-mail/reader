{
  "name": "@remit/imap-worker",
  "version": "0.0.1",
  "type": "module",
  "main": "dist/index.js",
  "exports": {
    ".": {
      "types": "./src/index.ts",
      "default": "./src/index.ts"
    },
    "./process": {
      "types": "./src/process.ts",
      "default": "./src/process.ts"
    },
    "./scheduler": {
      "types": "./src/scheduler/handler.ts",
      "default": "./src/scheduler/handler.ts"
    },
    "./mailbox-management": {
      "types": "./src/handlers/mailbox-management.ts",
      "default": "./src/handlers/mailbox-management.ts"
    },
    "./test-helpers/test-world": {
      "types": "./src/test-helpers/test-world.ts",
      "default": "./src/test-helpers/test-world.ts"
    }
  },
  "packManifest": {
    "main": "dist/index.js",
    "types": "dist/index.d.ts",
    "exports": {
      ".": {
        "types": "./dist/index.d.ts",
        "default": "./dist/index.js"
      },
      "./process": {
        "types": "./dist/process.d.ts",
        "default": "./dist/process.js"
      },
      "./scheduler": {
        "types": "./dist/scheduler/handler.d.ts",
        "default": "./dist/scheduler/handler.js"
      },
      "./mailbox-management": {
        "types": "./dist/handlers/mailbox-management.d.ts",
        "default": "./dist/handlers/mailbox-management.js"
      }
    },
    "files": [
      "dist"
    ]
  },
  "bin": {
    "remit-worker": "./dist/cli.js"
  },
  "scripts": {
    "prepack": "node ../../npm-scripts/pack-dist.mjs prepack",
    "postpack": "node ../../npm-scripts/pack-dist.mjs postpack",
    "bundle": "esbuild src/index.ts --sourcemap --bundle --platform=node --format=esm --outfile=dist/index.js",
    "cli": "node --env-file=../../localhost-dev-aws.env src/cli.ts",
    "test:typecheck": "tsgo --noEmit",
    "test:run": "node $NODE_TEST_FLAGS --env-file=../../localhost-test-unit.env --experimental-test-coverage --test-coverage-include='src/**' --test-coverage-exclude='src/**/*.test.ts' --test-coverage-exclude='src/**/*.test.tsx' --test-coverage-lines=86 --test 'src/**/*.test.ts'",
    "test": "npm run test:typecheck && npm run test:run",
    "dev": "node --import tsx src/e2e-processor-shim.ts"
  },
  "devDependencies": {
    "@remit/drizzle-service": "*",
    "@remit/queue-sidecar": "*",
    "@remit/storage-service": "*",
    "aws-sdk-client-mock": "*",
    "esbuild": "^0.28.1"
  },
  "dependencies": {
    "@remit/logger": "*",
    "@aws-sdk/client-s3": "^3.1055.0",
    "@remit/config-transfer": "*",
    "@remit/data-ports": "*",
    "@remit/smtp-service": "*",
    "@remit/logger-lambda": "*",
    "@remit/mailbox-service": "*",
    "@remit/sqs-client": "*",
    "@remit/backend": "*",
    "@remit/calendar-service": "*",
    "@remit/domain-enums": "*",
    "@remit/mail-oauth-service": "*",
    "@remit/secrets-service": "*",
    "@aws-sdk/client-sqs": "^3.1090.0",
    "@aws-sdk/client-ssm": "^3.1090.0",
    "expect-env": "^1.0.1",
    "p-map": "^2.1.0",
    "@types/aws-lambda": "^8.10.162"
  },
  "license": "MIT",
  "publishConfig": {
    "access": "public"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/remit-mail/reader.git",
    "directory": "packages/imap-worker"
  }
}
