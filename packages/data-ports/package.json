		"postpack": "node ../../npm-scripts/pack-dist.mjs postpack",
		"test:typecheck": "tsgo --noEmit",
		"test:run": "node $NODE_TEST_FLAGS --import tsx --experimental-test-coverage --test-coverage-include='src/**' --test-coverage-exclude='src/**/*.test.ts' --test-coverage-exclude='src/**/*.test.tsx' --test-coverage-lines=85 --test 'src/**/*.test.ts'"
