{
	"extends": "../../tsconfig.json",
	"compilerOptions": {
		"outDir": "dist",
		"jsx": "react-jsx",
		"lib": [
			"ES2022",
			"DOM",
			"DOM.Iterable"
		]
	},
	"include": [
		"src/**/*.ts",
