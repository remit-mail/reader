    "@remit/domain-enums": "*",
    "@remit/mailbox-service": "*",
    "@remit/storage-service": "*",
    "zod": "^3.25.0"
  },
  "devDependencies": {
    "@remit/drizzle-service": "*",
    "@remit/imap-worker": "*",
    "@types/better-sqlite3": "^7.6.13",
    "better-sqlite3": "^12.11.1",
    "tsx": "*"
  },
  "license": "MIT"
}
