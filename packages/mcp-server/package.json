{
  "name": "@remit/mcp-server",
  "version": "0.0.1",
  "description": "The remit MCP server: mail tools over streamable HTTP and the OAuth authorization server that guards them.",
  "type": "module",
  "exports": {
    "./app": {
      "types": "./src/app-entry.ts",
      "default": "./src/app-entry.ts"
    }
  },
  "scripts": {
    "prepack": "node ../../npm-scripts/pack-dist.mjs prepack && vite build --config vite.pages.config.ts --emptyOutDir=false",
    "postpack": "node ../../npm-scripts/pack-dist.mjs postpack",
    "build": "vite build --config vite.pages.config.ts",
    "test:typecheck": "tsgo --noEmit",
    "test:run": "node $NODE_TEST_FLAGS --env-file=../../localhost-test-unit.env --import tsx --test 'src/**/*.test.ts'",
    "test": "npm run test:typecheck && npm run test:run",
    "start": "MCP_PAGE_ASSETS_DIR=dist/pages node --import tsx src/main.ts",
    "mcp-login": "node --import tsx src/cli/mcp-login.ts"
  },
  "dependencies": {
    "@remit/logger": "*",
    "@better-auth/oauth-provider": "^1.7.12",
    "@hono/node-server": "^2.1.3",
    "@modelcontextprotocol/sdk": "1.32.1",
    "@remit/auth-service": "*",
    "@remit/data-ports": "*",
    "@remit/domain-enums": "*",
    "@remit/drizzle-service": "*",
    "@remit/mailbox-service": "*",
    "@remit/storage-service": "*",
    "@remit/ui": "0.0.234",
    "better-auth": "^1.7.12",
    "drizzle-orm": "1.0.0-rc.5",
    "jose": "^6.2.3",
    "react": "^19",
    "react-dom": "^19",
    "zod": "^4.6.7",
    "@remit/backend": "*",
    "@types/react": "^19",
    "@types/react-dom": "^19"
  },
  "devDependencies": {
    "@remit/imap-worker": "*",
    "@tailwindcss/vite": "^4",
    "tailwindcss": "^4",
    "tsx": "*",
    "vite": "^7.3.7"
  },
  "license": "MIT",
  "publishConfig": {
    "access": "public"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/remit-mail/reader.git",
    "directory": "packages/mcp-server"
  },
  "packManifest": {
    "exports": {
      "./app": {
        "types": "./dist/app-entry.d.ts",
        "default": "./dist/app-entry.js"
      },
      "./pages.css": "./dist/pages/pages.css"
    },
    "files": [
      "dist"
    ]
  }
}
