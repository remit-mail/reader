{
	"name": "@remit/calendar-service",
	"version": "0.0.1",
	"description": "iCalendar (RFC 5545) parsing, projection and recurrence expansion over the calendar store",
	"type": "module",
	"main": "src/index.ts",
	"types": "src/index.ts",
	"exports": {
		".": {
			"types": "./src/index.ts",
			"default": "./src/index.ts"
		},
		"./memory-store": {
			"types": "./src/memory-store.ts",
			"default": "./src/memory-store.ts"
		}
	},
	"packManifest": {
		"main": "dist/index.js",
		"types": "dist/index.d.ts",
		"exports": {
			".": {
				"types": "./dist/index.d.ts",
				"default": "./dist/index.js"
			},
			"./memory-store": {
				"types": "./dist/memory-store.d.ts",
				"default": "./dist/memory-store.js"
			}
		},
		"files": [
			"dist"
		]
	},
	"scripts": {
		"prepack": "node ../../npm-scripts/pack-dist.mjs prepack",
		"postpack": "node ../../npm-scripts/pack-dist.mjs postpack",
		"test:typecheck": "tsgo --noEmit",
		"test:run": "node $NODE_TEST_FLAGS --import tsx --experimental-test-coverage --test-coverage-include='src/**' --test-coverage-exclude='src/**/*.test.ts' --test-coverage-exclude='src/memory-store.ts' --test-coverage-lines=90 --test 'src/**/*.test.ts'"
	},
	"dependencies": {
		"@remit/api-openapi-types": "*",
		"@remit/data-ports": "*",
		"@remit/domain-enums": "*",
		"ical.js": "^2.2.1"
	},
	"license": "MIT",
	"publishConfig": {
		"access": "public"
	},
	"repository": {
		"type": "git",
		"url": "git+https://github.com/remit-mail/reader.git",
		"directory": "packages/calendar-service"
	}
}
