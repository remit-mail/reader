{
	"name": "@remit/config-format",
	"version": "0.0.1",
	"type": "module",
	"main": "src/index.ts",
	"types": "src/index.ts",
	"exports": {
		".": {
			"types": "./src/index.ts",
			"default": "./src/index.ts"
		},
		"./document": {
			"types": "./src/document.ts",
			"default": "./src/document.ts"
		},
		"./errors": {
			"types": "./src/errors.ts",
			"default": "./src/errors.ts"
		},
		"./read": {
			"types": "./src/read.ts",
			"default": "./src/read.ts"
		},
		"./json-schema": {
			"types": "./src/json-schema.ts",
			"default": "./src/json-schema.ts"
		}
	},
	"scripts": {
		"schema:emit": "node --import tsx src/bin/emit-schema.ts",
		"check:schema": "node --import tsx src/bin/check-schema.ts",
		"test:typecheck": "tsgo --noEmit",
		"test:run": "node $NODE_TEST_FLAGS --import tsx --experimental-test-coverage --test-coverage-include='src/**' --test-coverage-exclude='src/**/*.test.ts' --test-coverage-exclude='src/bin/**' --test-coverage-lines=95 --test 'src/**/*.test.ts' && npm run check:schema"
	},
	"license": "MIT",
	"publishConfig": {
		"access": "public"
	},
	"repository": {
		"type": "git",
		"url": "git+https://github.com/remit-mail/reader.git",
		"directory": "packages/config-format"
	},
	"dependencies": {
		"@remit/domain-enums": "*",
		"zod": "^3.25.0"
	}
}
