{
	"name": "@remit/smtp-worker",
	"version": "0.0.1",
	"type": "module",
	"main": "dist/index.js",
	"exports": {
		".": {
			"types": "./src/index.ts",
			"default": "./src/index.ts"
		},
		"./data-ports": {
			"types": "./src/data-ports.ts",
			"default": "./src/data-ports.ts"
		},
		"./process": {
			"types": "./src/process.ts",
			"default": "./src/process.ts"
		}
	},
	"scripts": {
		"bundle": "node build.mjs",
		"test:typecheck": "tsgo --noEmit",
		"test:run": "node $NODE_TEST_FLAGS --env-file=../../localhost-test-unit.env --experimental-test-module-mocks --experimental-test-coverage --test-coverage-include='src/**' --test-coverage-exclude='src/**/*.test.ts' --test-coverage-exclude='src/**/*.test.tsx' --test-coverage-exclude='src/lambda-context.ts' --test-coverage-lines=83 --test 'src/**/*.test.ts'",
		"test": "npm run test:typecheck && npm run test:run",
		"dev": "node --import tsx src/e2e-processor-shim.ts"
	},
	"dependencies": {
		"@remit/logger": "*",
		"@remit/data-ports": "*",
		"@remit/drizzle-service": "*",
		"@remit/logger-lambda": "*",
		"@remit/sqs-client": "*",
		"@remit/secrets-service": "*",
		"@remit/smtp-service": "*",
		"@remit/storage-service": "*",
		"@remit/domain-enums": "*",
		"@remit/mail-oauth-service": "*",
		"@remit/mailbox-service": "*",
		"@aws-sdk/client-sqs": "^3.1090.0",
		"expect-env": "^1.0.1",
		"@types/aws-lambda": "^8.10.162"
	},
	"devDependencies": {
		"esbuild": "^0.28.1"
	},
	"license": "MIT",
	"publishConfig": {
		"access": "public"
	},
	"repository": {
		"type": "git",
		"url": "git+https://github.com/remit-mail/reader.git",
		"directory": "packages/smtp-worker"
	}
}
