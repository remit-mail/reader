# Env for the one-command local SQLite + better-auth dev stack (docker compose).
# The relational store is a file, which is what the product ships
# (deploy/vps/docker-compose.sqlite.yml), so a dev session here exercises the
# code path a real install runs.
#
# Every value here is a local-dev throwaway: BETTER_AUTH_SECRET signs JWTs only
# against the local database file, and the AWS/KMS values are fakes. No
# cross-environment secret lives here — real login passwords are hashed in the
# database, not in this file.
#
# No LOCAL_ACCOUNT_CONFIG_ID here on purpose: identity comes from better-auth
# login, not an auth bypass.
#
# App containers run with host networking and the worktree bind-mounted at /app,
# so every host is localhost and every path below is an absolute /app path — the
# migrate one-shot runs with deploy/vps as its cwd (its drizzle folders are
# relative to that directory) and must resolve the same database file as the
# services that run from /app.

DATA_BACKEND=sqlite
SERVER_PORT=4124
NODE_ENV=development
NODE_NO_WARNINGS=1
HOME=/tmp
NODE_TLS_REJECT_UNAUTHORIZED=0

# SQLite — the app schema and the better-auth identity tables in one file
# (RFC 036 D3), with sqlite-vec's vector store in its own file beside it. Both
# live under .remit/dev-sqlite, which is gitignored; deleting that directory is
# what resets this stack.
SQLITE_DB_PATH=/app/.remit/dev-sqlite/remit.db
LOCAL_VECTORDB_PATH=/app/.remit/dev-sqlite/vec.db
STORAGE_LOCAL_PATH=/app/.remit/dev-sqlite/storage

# better-auth (local identity)
BETTER_AUTH_URL=http://localhost:4124
BETTER_AUTH_SECRET=dev-better-auth-secret-at-least-32-chars-long
BETTER_AUTH_JWKS_URL=http://localhost:4124/api/auth/jwks
BETTER_AUTH_TRUSTED_ORIGINS=http://localhost:4123

# Web origin / body content delivery
CONTENT_DELIVERY_DOMAIN=http://localhost:4123
CORS_ALLOWED_ORIGINS=http://localhost:4123

# KMS / AWS local fakes
KMS_KEY_ID=FAKE_KMS_KEY_ID
FAKE_KMS_DATAKEY=8AD6A6C8-B5E2-488F-B017-96B662DC01AC
AWS_ACCESS_KEY_ID=local
AWS_SECRET_ACCESS_KEY=local
AWS_REGION=not-a-region

# SQS (elasticmq)
SQS_QUEUE_URL=http://localhost:9324/000000000000/remit-local
SQS_QUEUE_URL_MAILBOXES=http://localhost:9324/000000000000/remit-mailboxes.fifo
SQS_QUEUE_URL_MESSAGES=http://localhost:9324/000000000000/remit-messages.fifo
SQS_QUEUE_URL_FLAGS=http://localhost:9324/000000000000/remit-flags.fifo
SQS_QUEUE_URL_BODY=http://localhost:9324/000000000000/remit-body
SQS_QUEUE_URL_MAILBOX_MGMT=http://localhost:9324/000000000000/remit-mailbox-mgmt
SQS_QUEUE_URL_MESSAGE_MGMT=http://localhost:9324/000000000000/remit-message-mgmt
SQS_QUEUE_URL_SEARCH_INDEX=http://localhost:9324/000000000000/remit-search-index
SQS_QUEUE_URL_ATTACHMENT_SCAN=http://localhost:9324/000000000000/remit-attachment-scan
WORKER_MAX_CONCURRENCY=3
WORKER_MAX_CONCURRENCY_BODY=1
BODY_SYNC_CONCURRENCY=3
BODY_SYNC_ENABLED_PARAMETER_NAME=/development/Remit/bodySyncEnabled

# Periodic mailbox-sync scheduler (#1247, restructured #1251) — read by the
# scheduler service and, in production, by the EventBridge-scheduled Lambda. The
# runtime default tick (1 hour, matching production) would sit above the offline
# threshold below and a local session would never observe a scheduled sync, so
# both are shortened here: the tick runs every minute and the offline threshold
# is 10 minutes.
MAILBOX_SYNC_TICK_INTERVAL_SECONDS=60
MAILBOX_SYNC_OFFLINE_INTERVAL_SECONDS=600

# Semantic search. A real embedder, not the deterministic bag-of-words one the
# e2e lane uses: this stack is for reading actual mail, so the vectors have to
# mean something. The multilingual MiniLM matches the shipped stack —
# roughly half the corpus is not English — and its weights are cached under
# node_modules/@huggingface/transformers/.cache, which is inside the bind mount
# and so survives container restarts.
SEARCH_EMBEDDING_PROVIDER=local
SEARCH_EMBEDDING_MODEL_ID=Xenova/paraphrase-multilingual-MiniLM-L12-v2
SEARCH_EMBEDDING_DIMENSIONS=384

# Vite (web)
VITE_PROXY_BACKEND_PORT=4124
VITE_BETTER_AUTH_ENABLED=1
SQS_QUEUE_URL_ACCOUNT_FANOUT=http://localhost:9324/000000000000/remit-account-fanout
SQS_QUEUE_URL_ACCOUNT_FINALIZE=http://localhost:9324/000000000000/remit-account-finalize
SQS_QUEUE_URL_ACCOUNT_PURGE_DELETE=http://localhost:9324/000000000000/remit-account-purge-delete.fifo
