#!/bin/sh
#
# remit — admin wrapper for the self-host docker compose deployment.
#
# Wraps `docker compose` against the deployment directory so the operator
# never has to cd there or repeat -f/--env-file. install.sh rewrites both
# DEFAULT_DIR and COMPOSE_FILE below to what it installed; $REMIT_DIR selects
# a different directory.
#
# $REMIT_DIR chooses which deployment is managed: its .env names the Compose
# project, and containers, volumes and the network all carry that name. Two
# directories with the same project name are one deployment; a second one
# installed with --project is its own.

set -eu

DEFAULT_DIR=/opt/remit
COMPOSE_FILE=docker-compose.sqlite.yml
REMIT_DIR="${REMIT_DIR:-$DEFAULT_DIR}"

# What this wrapper calls itself in its own output. install.sh rewrites it, the
# same way it rewrites DEFAULT_DIR: a second deployment is managed with
# `remit-<project>`, and a message telling its operator to run `remit` names the
# other deployment's stack.
PROG=remit

# --- self-update configuration (RFC 037) ------------------------------------
#
# STATE_DIR is where a run's lock, breadcrumb, state and snapshots live: the
# updater's own volume when this wrapper runs inside the updater container, a
# directory beside .env when an operator runs it from a shell. Never remit.db —
# a rollback restores that file to before the run, which would destroy the
# record of the rollback describing it.
#
# STATE_MOUNT is the same location named the way the *host* docker daemon reads
# it, because the helper containers below bind it. They are the same string
# outside a container; inside the updater they are not, so #133's compose
# service sets STATE_MOUNT to the volume it mounted.
STATE_DIR="${REMIT_UPDATE_STATE_DIR:-$REMIT_DIR/.update}"
STATE_MOUNT="${REMIT_UPDATE_STATE_MOUNT:-$STATE_DIR}"

# CONTROL_DIR is the seam the app drives through (#133): the backend writes
# request.json here and reads state.json back, on a volume shared with the
# updater and nothing else. It is separate from STATE_DIR — the run's lock,
# breadcrumb and snapshots stay on the updater's private volume, out of the
# backend's reach. An operator at a shell has no second volume, so it defaults
# to STATE_DIR and the two are one directory.
CONTROL_DIR="${REMIT_UPDATE_CONTROL_DIR:-$STATE_DIR}"

# The database lives on a named volume, so reading and writing it means a
# container either way. alpine is what the backup sidecar already uses, and the
# restore path deliberately needs nothing installed into it — a rollback must
# not depend on the network that just failed. The updater container overrides
# this with its own image, which bakes sqlite3 in so a snapshot never waits on
# an apk install (#133).
HELPER_IMAGE="${REMIT_UPDATE_HELPER_IMAGE:-alpine:3.23}"

# The host docker socket, for the one helper that drives compose rather than a
# volume: the detached container that recreates the updater service (reader#291).
DOCKER_SOCKET="${REMIT_UPDATE_DOCKER_SOCKET:-/var/run/docker.sock}"

# A hard ceiling on any helper `docker run`. A `docker run` bounds nothing by
# itself: an updater image whose ENTRYPOINT ignored its arguments turned a health
# probe into an immortal daemon and hung a verify for eight hours (reader#284),
# and a wedged docker CLI does the same to any phase. timeout is coreutils or
# busybox and ships in the updater image; where it is absent the command runs
# uncapped, which is no worse than before. The probe ceiling is tighter than the
# volume one because a probe is a single HTTP GET, not a VACUUM over a mailbox
# index that a first snapshot can legitimately spend a minute on.
HELPER_RUN_TIMEOUT="${REMIT_UPDATE_HELPER_TIMEOUT:-120}"
PROBE_RUN_TIMEOUT="${REMIT_UPDATE_PROBE_RUN_TIMEOUT:-15}"

# The staleness ceiling for a lock whose holder cannot be placed alive or dead by
# pid or container (a legacy identity-less lock, or one written by a holder that
# died before its identity landed). It is a last-resort backstop — a live holder
# is recognised by its pid or its container long before this — so it is set well
# beyond any real update, pull included.
LOCK_STALE_CEILING="${REMIT_UPDATE_LOCK_STALE:-3600}"

# The VACUUM INTO primitive the helper container sources. An operator at a shell
# bind-mounts it from the install directory; the updater image bakes it at
# /snapshot-db.sh and clears this so no bind mount is attempted — a container
# path would not resolve against the host daemon the helper `docker run` talks
# to. Unset falls back to the install-directory copy; empty skips the mount.
SNAPSHOT_LIB_MOUNT="${REMIT_UPDATE_SNAPSHOT_LIB-$REMIT_DIR/backup/snapshot-db.sh}"

# 300 seconds from `up -d` returning. Generous on purpose: a release that
# migrates a large mailbox index is the normal slow case, and rolling back a
# healthy-but-slow upgrade is worse than waiting.
GATE_BUDGET_SECONDS="${REMIT_UPDATE_GATE_BUDGET:-300}"

# Condition 4 is three consecutive answers 2 seconds apart, which is also the
# rhythm every other condition is re-read on. Still three real answers over a
# real interval — the window is what shrank, so a backend that is up is
# discovered in a few seconds rather than ~10, without weakening the "does not
# just flap once" guarantee.
GATE_PROBE_INTERVAL="${REMIT_UPDATE_PROBE_INTERVAL:-2}"

# Nothing is served and no worker runs between the snapshot and the verdict, so
# nothing is written, sent, purged or indexed in the window. volume-init joins
# by depends_on whether or not it is named.
GATE_SET="queue migrate backend"

# Scoped for gate conditions 2 and 3: migrate and volume-init are one-shots that
# exit by design, and caddy and backup are stock upstream images a tag change
# does not touch.
GATE_SERVICES="queue backend"

# The one-shots, by name. Exiting is how they succeed, so a list of services
# checked for what came back after an `up` has to leave them out or read every
# successful run as a failure.
ONE_SHOT_SERVICES="migrate volume-init"

die() {
	printf '%s: %s\n' "$PROG" "$1" >&2
	exit 1
}

usage() {
	cat <<EOF
Usage: $PROG <command> [args]

  restart [--hard]     Start serving, applying any .env change. --hard stops
                       the stack first.
  logs [service...]    Follow logs (last 100 lines).
  status               Services and the running tag, plus whether the origin
                       resolves to this box and answers, the last update check
                       and the last update's outcome.
  update [--tag TAG]   Install a release. Wherever there is a database on the
                       volume this is atomic: the databases are snapshotted
                       before anything is stopped, the new version has to pass
                       a health gate before anything is served, and a failure
                       restores the snapshot and the previous tag. A stopped
                       stack is started to be gated.
  update --check       Check for a newer release and report, changing nothing.
  update --recover     Finish an update that was interrupted, committing or
                       rolling back on the gate's verdict. Runs at the
                       updater's start; safe to run by hand.
  update --preflight   Prove the updater is mounted at the deployment
                       directory's host path before it drives an update. Runs
                       at the updater's start; records a failure for the app.
  down                 Stop serving: the site goes offline until 'remit
                       restart'. Accounts, mail and settings are untouched.
  purge --yes          Destroy the deployment: containers and every data
                       volume, accounts included. Without --yes it only says
                       what would go. Use 'down' to merely stop serving.
  doctor [--json]      Report whether anything is wrong: work quarantined on a
                       dead-letter queue, an account that stopped syncing, a
                       worker that stopped polling, mail authentication
                       failing. Exits 0 healthy, 1 degraded, 2 when no verdict
                       could be produced, so cron or an external monitor can
                       call it directly.
  config               Print the effective configuration, secrets redacted.
  config save <file>   Write every setting — accounts, filters, labels, folder
    [--user <email>]   roles, signatures, flagged senders — to <file> as one
                       versioned JSON document. No password and no OAuth token
                       goes in it, so importing it asks for each account's
                       credentials again. Run it before anything that drops the
                       database. --user picks the sign-in on an instance that
                       holds more than one.
  check-categories     Report whether the mail list's category column agrees
                       with the messages it copies, per cause. Reads the
                       database and writes nothing. The repair itself runs on
                       every start; this is how to look without waiting for one.
  cert                 Export Caddy's root CA to the current directory, so
                       browsers stop warning (TLS_MODE=internal only).
  probe-host <origin>  Report how a name resolves from this box. Used by
                       install.sh; useful on its own to check an origin.
  help                 This message.

Deployment directory: $REMIT_DIR (override with \$REMIT_DIR)
Compose file:         $REMIT_DIR/$COMPOSE_FILE
EOF
}

compose() {
	docker compose \
		--project-directory "$REMIT_DIR" \
		-f "$REMIT_DIR/$COMPOSE_FILE" \
		--env-file "$REMIT_DIR/.env" \
		"$@"
}

# Compose only sees a service whose profile is active. Every command that claims
# to act on the whole deployment — stopping it, destroying it, listing what it
# would destroy — has to say so, or it acts on the always-on services and
# reports as though it acted on all of them. `remit purge` left dozzle running
# with the docker socket and the metrics volume on disk for exactly that reason.
#
# Use this for the commands whose contract is "everything". Not for `up`: that
# would start the optional profiles on a deployment that never asked for them.
compose_all() {
	docker compose \
		--project-directory "$REMIT_DIR" \
		-f "$REMIT_DIR/$COMPOSE_FILE" \
		--env-file "$REMIT_DIR/.env" \
		--profile '*' \
		"$@"
}

# Containers that exist only because an optional profile was turned on. `remit`
# never starts these, so a command that stops them has to tell the operator how
# to get them back. The single reader of profile state: every command that
# stops, restores or reports on the optional profiles goes through this.
#
# Both live states, not only `running`. Compose reports a crash-looping
# container as `restarting`, and a container this deployment is trying and
# failing to run is one the operator has enabled — filtering it out has a
# command stop it and then decline to restore it, which turns a container
# visibly failing every few seconds into one that is silently gone. `exited` is
# excluded on purpose: that is a container something stopped deliberately
# (`remit down`, or the operator), and starting it back is not this wrapper's
# call.
running_profile_services() {
	_always=$(compose config --services 2>/dev/null)
	compose_all ps --services --status running --status restarting 2>/dev/null | while IFS= read -r _svc; do
		[ -n "$_svc" ] || continue
		printf '%s\n' "$_always" | grep -qxF "$_svc" || printf '%s ' "$_svc"
	done
}

# Of a list of services, the ones no longer in a live state. What a restore has
# to check before it reports success: `compose up -d` exiting 0 is not the same
# as the container being there afterwards.
stopped_among() {
	_live=$(compose_all ps --services --status running --status restarting 2>/dev/null)
	for _svc in $1; do
		printf '%s\n' "$_live" | grep -qxF "$_svc" || printf '%s ' "$_svc"
	done
}

# Profile services that have a container and are not live. Either a restore
# tried and failed, or the container was already stopped before the command ran.
# The operator's next move is the same for both, and without the line they get
# neither: a profile that sheds one container per restart, in silence, is how a
# box ends up with dozzle serving and no metrics behind it.
stopped_profile_services() {
	_always=$(compose config --services 2>/dev/null)
	_live=$(compose_all ps --services --status running --status restarting 2>/dev/null)
	compose_all ps -a --services 2>/dev/null | while IFS= read -r _svc; do
		[ -n "$_svc" ] || continue
		printf '%s\n' "$_always" | grep -qxF "$_svc" && continue
		printf '%s\n' "$_live" | grep -qxF "$_svc" && continue
		printf '%s ' "$_svc"
	done
}

# The one incantation that brings an optional profile back. `remit` never starts
# a profile on its own, so every command that can leave one down owes the
# operator this line, and there is one copy of it to owe.
profile_recovery_hint() {
	printf '  %s\n' "${1% }"
	printf "Bring them back with:\n"
	printf "  docker compose -f %s --env-file .env --profile observability up -d\n" "$COMPOSE_FILE"
}

# The profile services a `restart` stopped, written before anything stops.
#
# A shell variable dies with the process, and the window between the stop and
# the restore is exactly where this command fails: `apply` calls die on the bad
# .env edit that this command exists to apply, and an interrupted ssh session
# takes the rest. Either way the record is what says the operator had these
# running, so it goes on disk beside the .env it is about, and the next
# `restart` consumes it. `update` keeps the same kind of record in its
# breadcrumb, but it has `update --recover` to act on one; `restart` has no
# recover subcommand, so the next run of the command itself is the consumer.
PROFILE_HOLD="$REMIT_DIR/.remit-profiles-held"

# Written the same way as .env: into a temp file that replaces the record in one
# rename, carrying the original's owner and mode. A truncate-then-write is a
# window where a killed run leaves the record empty — and this record exists
# precisely to survive a killed run. Clearing it takes the temp with it, so a
# run killed inside that window leaves nothing behind a `down` or a `purge`.
profile_hold_write() {
	if [ -z "$1" ]; then
		rm -f "$PROFILE_HOLD" "$PROFILE_HOLD.tmp"
		return 0
	fi
	_own=$(owner_mode_of "$PROFILE_HOLD")
	rm -f "$PROFILE_HOLD.tmp"
	printf '%s\n' "$1" >"$PROFILE_HOLD.tmp"
	restore_owner_mode "$PROFILE_HOLD.tmp" "$_own"
	mv "$PROFILE_HOLD.tmp" "$PROFILE_HOLD"
}

profile_hold_read() {
	cat "$PROFILE_HOLD" 2>/dev/null || true
}

# Each name once, order preserved.
uniq_services() {
	for _svc in $1; do printf '%s\n' "$_svc"; done | awk '!seen[$0]++' | tr '\n' ' '
}

# Of a list of services, the ones the compose file still defines.
#
# The record outlives the compose file it was written against: a service renamed
# or removed by an update leaves its old name behind. `compose up -d a b c`
# refuses the whole invocation on one name it does not know rather than starting
# the rest, and the restore then records every name it failed to start — the
# dead one included — so one stale name holds the whole profile down and writes
# itself back on every restart after that (reader#412). The compose file is the
# authority on what can be started, and a name it no longer has does not belong
# in a record of what to bring back.
#
# `--profile '*'`, because the record is about the optional profiles and an
# unscoped `config --services` does not list them.
#
# Two listings this cannot be derived from, and on both nothing is dropped:
#
# Nothing at all is a compose file this wrapper cannot read, not a deployment
# with no services. The restore fails on its own terms rather than discarding a
# record over a file the operator is about to fix.
#
# The same listing as the unscoped one is `--profile '*'` selecting no profile,
# which is what it does below Compose 2.30 — every optional service missing from
# a list this then reads as the whole project, so every name in the record looks
# removed and the restore drops services that are sitting in the compose file.
# install.sh refuses to install below 2.30, so this is a floor under a host that
# went backwards, not a supported configuration; the compose file always
# declares a profile, so the two listings agreeing means the flag did nothing.
#
# Both listings are sorted before they are compared: `config --services` emits
# in no particular order, and two runs of the same command differ. The match is
# fixed-string, because a compose service name may contain a `.` and a name that
# matches by accident is a dead name kept forever.
known_services() {
	_known=$(compose_all config --services 2>/dev/null | sort)
	if [ -z "$_known" ] || [ "$_known" = "$(compose config --services 2>/dev/null | sort)" ]; then
		printf '%s' "$1"
		return 0
	fi
	for _svc in $1; do
		printf '%s\n' "$_known" | grep -qxF "$_svc" && printf '%s ' "$_svc"
	done
	return 0
}

# Of a list of services, the ones a second list does not name.
services_not_in() {
	for _svc in $1; do
		case " $2 " in
		*" $_svc "*) ;;
		*) printf '%s ' "$_svc" ;;
		esac
	done
	return 0
}

require_deployment() {
	[ -f "$REMIT_DIR/$COMPOSE_FILE" ] ||
		die "no $COMPOSE_FILE in $REMIT_DIR — point \$REMIT_DIR at the install directory, or run install.sh"
	[ -f "$REMIT_DIR/.env" ] ||
		die "no .env in $REMIT_DIR — point \$REMIT_DIR at the install directory, or run install.sh"
	# A present-but-unreadable .env is a local permission error, not a missing
	# deployment. `docker compose --env-file .env` fails on it with "permission
	# denied", which the pull-failure heuristic would otherwise read as a registry
	# refusal (reader#273). Name it for what it is, and where it comes from.
	[ -r "$REMIT_DIR/.env" ] ||
		die "cannot read $REMIT_DIR/.env — the file exists but this user cannot read it.
An earlier in-container update rewrote it as root before reader#273; check its
owner with 'ls -l $REMIT_DIR/.env' and give it back to yourself:
  sudo chown \$(id -u):\$(id -g) $REMIT_DIR/.env
This is a local file-permission error, not a registry or network problem."
}

get_var() {
	_k=$1
	_k="$_k" awk '
		BEGIN { k = ENVIRON["_k"] }
		index($0, k "=") == 1 { print substr($0, length(k) + 2); exit }
	' "$REMIT_DIR/.env"
}

# The Compose project this deployment is, read from the file Compose reads it
# from — so the name a helper `docker run` uses to reach a volume is the name
# Compose gave that volume, whatever else is installed on the box.
compose_project() {
	_project=$(get_var REMIT_PROJECT 2>/dev/null || true)
	[ -n "$_project" ] || _project=remit
	printf '%s' "$_project"
}

# Rewriting a file the operator owns must not change who owns it. Inside the
# updater container this wrapper runs as root against the bind-mounted
# deployment directory, so a plain write-temp-then-rename lands the replacement
# root:root and locks the host user out of their own .env — a host-side
# `docker compose --env-file .env` then dies on EACCES with the updater already
# down and no operator on the box to chown it back (reader#273). Capture the
# original's owner and mode before the write and restore them onto the
# replacement; chown/chmod only take effect as root and degrade to no-ops at an
# unprivileged shell, where the operator already owns everything anyway.

# Emits "uid gid mode" for a path, coreutils `-c` first and BSD `-f` as the
# fallback. Always succeeds: a stat that is absent or errors yields nothing and
# still returns 0, so under set -eu it degrades to a no-op restore — the rewrite
# still lands (root-owned, as before this existed) rather than aborting the whole
# update before the tag is even written (reader#273).
owner_mode_of() {
	stat -c '%u %g %a' "$1" 2>/dev/null && return 0
	stat -f '%u %g %Lp' "$1" 2>/dev/null || return 0
}

# Restores a captured "uid gid [mode]" onto a path, before it is renamed into
# place. Best-effort by design: a chown that cannot run is the unprivileged
# shell where it is already unnecessary.
restore_owner_mode() {
	_target=$1
	# shellcheck disable=SC2086 # "uid gid [mode]" is split into fields on purpose
	set -- $2
	[ -n "${1:-}" ] && [ -n "${2:-}" ] || return 0
	chown "$1:$2" "$_target" 2>/dev/null || true
	if [ -n "${3:-}" ]; then
		chmod "$3" "$_target" 2>/dev/null || true
	fi
	return 0
}

# The temp file holds FAKE_KMS_DATAKEY like the .env it replaces, so it is
# created under a 077 umask rather than chmod'd after the write: a chmod after
# the fact leaves the secrets world-readable for the length of the write. The
# original's owner and mode are then restored onto it, so the rename preserves
# who owns .env rather than adopting the temp file's writer (reader#273).
set_var() {
	_k=$1
	_v=$2
	_own=$(owner_mode_of "$REMIT_DIR/.env")
	rm -f "$REMIT_DIR/.env.tmp"
	(
		umask 077
		_k="$_k" _v="$_v" awk '
			BEGIN { k = ENVIRON["_k"]; v = ENVIRON["_v"]; done = 0 }
			!done && index($0, k "=") == 1 { print k "=" v; done = 1; next }
			{ print }
			END { if (!done) print k "=" v }
		' "$REMIT_DIR/.env" >"$REMIT_DIR/.env.tmp"
	)
	restore_owner_mode "$REMIT_DIR/.env.tmp" "$_own"
	mv "$REMIT_DIR/.env.tmp" "$REMIT_DIR/.env"
}

# Shared by `update` and by install.sh, which calls this wrapper rather than
# repeating the pull/up/migrate-gate sequence.
#
# The pull moves ~4 GB on a first install (search-index-worker alone is
# ~1.36 GB), so its progress is streamed rather than buffered for a diagnosis
# that is usually never needed — buffering makes a working install look hung
# for minutes. The copy kept on the side is only there to classify a failure,
# and the pull's own exit status has to be carried out of the pipeline by hand
# because the pipeline reports tee's.
pull_images() {
	_log=$(mktemp) || die "cannot create a temporary file for the pull log"
	_status=$(mktemp) || die "cannot create a temporary file for the pull status"
	# `|| _rc=$?` is what keeps set -e from killing the subshell before the
	# status is recorded; the status has to travel by file because the subshell
	# cannot assign to this one.
	{
		_rc=0
		compose pull 2>&1 || _rc=$?
		printf '%s' "$_rc" >"$_status"
	} | tee "$_log"
	_code=$(cat "$_status" 2>/dev/null || printf 1)
	rm -f "$_status"
	if [ "$_code" = "0" ]; then
		rm -f "$_log"
		return 0
	fi
	if grep -qiE 'denied|unauthorized|401|403' "$_log"; then
		rm -f "$_log"
		die "a registry refused the pull (see above).

This is not a missing token. Every image here pulls anonymously — the
ghcr.io/remit-mail/reader/* packages are public — so a refusal means a
credential was sent and rejected: an expired or revoked token left in
~/.docker/config.json by an earlier 'docker login' is offered instead of
pulling anonymously. Drop it and retry:

  docker logout ghcr.io       # or whichever registry the error names above
  remit update

Credentials are per-user, so a login done under sudo lives in root's config,
not yours. If neither is it, check whether the docker daemon is pointed at a
registry mirror or proxy fronting the registry above."
	fi
	rm -f "$_log"
	die "docker compose pull failed (see above)"
}

# migrate is a one-shot that every app service gates on
# (service_completed_successfully). If it fails, `up -d` reports a dependency
# error and the real cause is only in migrate's own logs.
check_migrate() {
	_cid=$(compose ps -aq migrate 2>/dev/null || true)
	if [ -z "$_cid" ]; then
		die "the migrate one-shot never ran — the stack is not usable"
	fi
	_code=$(docker inspect -f '{{.State.ExitCode}}' "$_cid" 2>/dev/null || echo 1)
	if [ "$_code" != "0" ]; then
		printf '\n--- migrate logs ---\n' >&2
		compose logs --no-log-prefix migrate >&2 2>/dev/null || true
		printf -- '--- end migrate logs ---\n\n' >&2
		die "the database migration failed (exit $_code). No app service starts until it succeeds."
	fi
}

apply() {
	if ! compose up -d; then
		check_migrate
		die "docker compose up failed (see above)"
	fi
	check_migrate
}

cmd_restart() {
	require_deployment
	if [ -n "${1:-}" ] && [ "$1" != "--hard" ]; then
		die "restart: unknown option '$1'"
	fi
	# An unscoped `up` never names a service behind a profile, so without this
	# the line printed at the end is false for the observability containers: a
	# raised REMIT_METRICS_RETENTION never reaches VictoriaMetrics and the
	# operator keeps losing data at the old retention with nothing to see.
	#
	# What is live now, plus whatever a previous run stopped and never got to
	# restore. Only services that were up are restored, so a profile nobody
	# turned on stays off.
	_profiled=$(uniq_services "$(running_profile_services) $(profile_hold_read)")
	profile_hold_write "$_profiled"
	if [ "${1:-}" = "--hard" ]; then
		# All profiles, or --hard stops the always-on services and leaves the
		# optional ones up on the configuration it just claimed to replace.
		compose_all stop
	fi
	# up -d, never `compose restart`: restart reuses existing containers and
	# ignores .env changes, so config edits appear to apply but do not.
	apply
	restore_profiles "$_profiled"
	report_serving
	printf 'Configuration in %s/.env is live.\n' "$REMIT_DIR"
	# Last, because it is the one line here the operator has to act on, and the
	# address still leads the part that says the command worked.
	report_profiles_gone
	report_profiles_down
}

# The optional profiles, after the always-on stack is back. A failure here is
# not fatal — the deployment is serving and the operator still wants the origin
# printed — but it must not be silent either: nothing else brings these back.
# What was recorded and did not come back stays on disk, so the next `restart`
# tries again; everything still stopped is named, whether this run tried it or
# left it alone, because the operator's move is the same line either way.
#
# Only reached with something to restore, so a deployment that ran `remit down`
# — every profile container stopped on purpose — says nothing.
PROFILES_DOWN=""

# Names the record carries that the compose file no longer defines. Reported
# once, as they are dropped: the operator asked for a service that this
# deployment does not have any more, and the profile advice below is not the
# answer to that.
PROFILES_GONE=""

restore_profiles() {
	PROFILES_DOWN=""
	PROFILES_GONE=""
	if [ -z "$1" ]; then
		profile_hold_write ""
		return 0
	fi
	_startable=$(known_services "$1")
	PROFILES_GONE=$(services_not_in "$1" "$_startable")
	if [ -n "$_startable" ]; then
		# shellcheck disable=SC2086 # the recorded service list, split on purpose
		compose up -d $_startable || true
	fi
	# Only what could be started is recorded again, so a name this deployment can
	# never start leaves the record on the run that finds it gone.
	profile_hold_write "$(stopped_among "$_startable")"
	PROFILES_DOWN=$(stopped_profile_services)
}

report_profiles_down() {
	[ -n "$PROFILES_DOWN" ] || return 0
	printf "\nStopped, and this restart did not bring them back:\n"
	profile_recovery_hint "$PROFILES_DOWN"
}

report_profiles_gone() {
	[ -n "$PROFILES_GONE" ] || return 0
	printf "\nDropped from the restart record — no longer a service in %s:\n" "$COMPOSE_FILE"
	printf '  %s\n' "${PROFILES_GONE% }"
}

cmd_logs() {
	require_deployment
	compose logs -f --tail=100 "$@"
}

# What the operator wants after a command that leaves the stack serving is the
# address, so it leads. A deployment part-way through configuration may not have
# one yet; that is not a reason to fail the command that just succeeded.
#
# install.sh sets $REMIT_QUIET because it prints its own summary immediately
# after, and two "Open <origin>" lines a screen apart read as two deployments.
report_serving() {
	if [ "${REMIT_QUIET:-0}" = "1" ]; then
		return 0
	fi
	_origin=$(get_var PUBLIC_ORIGIN 2>/dev/null || true)
	[ -n "$_origin" ] || return 0
	printf 'Open %s\n' "$_origin"
}

# --- reachability -----------------------------------------------------------
#
# A stack can be perfectly healthy and still be unreachable, because the name in
# PUBLIC_ORIGIN is answered somewhere the operator does not control. From the
# box that failure is invisible: the name resolves, the stack serves, `ps` is
# all green, and the browser hangs. These probes exist to name that case.
#
# `status` is what an operator types when something is already wrong, so no
# probe may hang, none may fail the command, and a missing tool degrades to a
# printed reason. install.sh runs `remit probe-host` rather than carrying a
# second copy of any of this.

PROBE_TIMEOUT=3

# coreutils timeout is the only thing that caps a command that will not cap
# itself. dig (+time), host (-W) and curl (-m) do; `getent ahosts` has no such
# flag, which is why resolver_tool drops it to last resort when timeout is
# missing rather than letting it block on the resolver's full retry budget.
capped() {
	if command -v timeout >/dev/null 2>&1; then
		timeout "$PROBE_TIMEOUT" "$@" 2>/dev/null || true
		return 0
	fi
	"$@" 2>/dev/null || true
}

have() { command -v "$1" >/dev/null 2>&1; }

origin_host() {
	_h=${1#*://}
	_h=${_h%%/*}
	_h=${_h#*@}
	case "$_h" in
	"["*) # bracketed IPv6 literal
		_h=${_h#[}
		_h=${_h%%]*}
		;;
	*) _h=${_h%%:*} ;;
	esac
	printf '%s' "$_h"
}

resolver_tool() {
	if have timeout; then
		set -- getent dig host
	else
		set -- dig host getent
	fi
	for _t in "$@"; do
		if have "$_t"; then
			printf '%s' "$_t"
			return 0
		fi
	done
	return 1
}

# A name that does not resolve is an ordinary empty result, never a failure.
# grep exits 1 on no match, which under a shell with `set -o pipefail` — as
# install.sh has, and this script does not — would otherwise become the
# pipeline's status and abort the caller. The braces contain it in both.
resolve_host() {
	case "$(resolver_tool)" in
	getent) capped getent ahosts "$1" | awk '{print $1}' | sort -u | tr '\n' ' ' ;;
	dig)
		# Both families explicitly: bare `dig +short` asks for A only, and a
		# box reachable over IPv6 alone would read as pointing elsewhere.
		{
			capped dig +short +time=2 +tries=1 A "$1"
			capped dig +short +time=2 +tries=1 AAAA "$1"
		} | { grep -E '^[0-9a-fA-F.:]+$' || true; } | sort -u | tr '\n' ' '
		;;
	host) capped host -W 2 "$1" | awk '/has( IPv6)? address/ {print $NF}' | sort -u | tr '\n' ' ' ;;
	esac
}

# An origin may name an address directly. getent resolves a literal to itself;
# dig and host ask DNS about it and come back empty, which would read as a name
# that does not resolve. Answer it here instead of per-tool.
is_ip_literal() {
	case "$1" in
	*:*) return 0 ;;
	*[!0-9.]*) return 1 ;;
	*.*) return 0 ;;
	esac
	return 1
}

local_addresses() {
	if have ip; then
		capped ip -o addr show | awk '{print $4}' | cut -d/ -f1
		return 0
	fi
	if have ifconfig; then
		capped ifconfig | awk '/inet6? /{print $2}' | sed 's/^addr://'
		return 0
	fi
	return 1
}

# The one classification both callers need, as one line: a verdict and the
# addresses behind it. install.sh formats its own pre-install wording from
# this; cmd_status formats the diagnostic wording below.
#
#   unresolved              the name answers with nothing
#   unknown                 no resolver, or this box's own addresses are unreadable
#   loopback <addrs>        resolves here and only here
#   held <addrs>            resolves to an address this box holds
#   elsewhere <addrs>       resolves to an address it does not
probe_host() {
	_host=$(origin_host "$1")
	if [ -z "$_host" ]; then
		printf 'unknown\n'
		return 0
	fi
	if is_ip_literal "$_host"; then
		_addrs=$_host
	else
		if ! resolver_tool >/dev/null; then
			printf 'unknown\n'
			return 0
		fi
		_addrs=$(resolve_host "$_host")
		_addrs=${_addrs% }
		if [ -z "$_addrs" ]; then
			printf 'unresolved\n'
			return 0
		fi
	fi

	_loopback_only=1
	for _a in $_addrs; do
		case "$_a" in
		127.* | ::1) ;;
		*) _loopback_only=0 ;;
		esac
	done
	if [ "$_loopback_only" = "1" ]; then
		printf 'loopback %s\n' "$_addrs"
		return 0
	fi

	_local=$(local_addresses || true)
	if [ -z "$_local" ]; then
		printf 'unknown %s\n' "$_addrs"
		return 0
	fi
	for _a in $_addrs; do
		for _l in $_local; do
			if [ "$_a" = "$_l" ]; then
				printf 'held %s\n' "$_addrs"
				return 0
			fi
		done
	done
	printf 'elsewhere %s\n' "$_addrs"
}

serve_probe() {
	if have curl; then
		# -k: internal mode is self-signed on purpose. An untrusted certificate
		# is the documented state there, not a reachability failure.
		_code=$(capped curl -k -s -o /dev/null -m "$PROBE_TIMEOUT" -w '%{http_code}' "$1")
		case "$_code" in
		"" | 000) printf 'no answer within %ss\n' "$PROBE_TIMEOUT" ;;
		*) printf 'HTTP %s\n' "$_code" ;;
		esac
		return 0
	fi
	if have wget; then
		if capped wget -q -O /dev/null --no-check-certificate -T "$PROBE_TIMEOUT" -t 1 "$1"; then
			printf 'answers\n'
		else
			printf 'no answer within %ss\n' "$PROBE_TIMEOUT"
		fi
		return 0
	fi
	printf 'not checked (no curl or wget)\n'
}

# TLS_MODE=tunnel puts the public address and the certificate at the provider's
# edge, so the hostname answering with an address this box does not hold is the
# topology working, and "resolves to this box" is a line it can never satisfy.
# What can fail instead is the agent's connection to that edge.
TUNNEL_READY_DEFAULT="http://tunnel:2000/ready"

# The readiness endpoint answers 200 only while at least one connection to the
# edge is established, and the agent publishes no port — nothing on the host can
# dial it. caddy is the always-on service on the same network with a shell.
tunnel_probe() {
	# shellcheck disable=SC2016 # $0 and $1 belong to the embedded script
	compose exec -T caddy sh -c '
		command -v wget >/dev/null 2>&1 || { printf unchecked; exit 0; }
		if wget -q -T "$1" -O /dev/null "$0"; then
			printf connected
		else
			printf down
		fi
	' "$1" "$PROBE_TIMEOUT" 2>/dev/null || true
}

tunnel_state() {
	_running=$(compose ps --services --status running --status restarting 2>/dev/null || true)
	case " $(printf '%s' "$_running" | tr '\n' ' ') " in
	*" tunnel "*) ;;
	*)
		printf "agent not running — nothing is holding the connection open"
		return 0
		;;
	esac
	_url=$(get_var TUNNEL_READY_URL)
	[ -n "$_url" ] || _url=$TUNNEL_READY_DEFAULT
	case "$(tunnel_probe "$_url")" in
	connected) printf 'agent connected to the edge' ;;
	down) printf "agent running, no connection to the edge — 'remit logs tunnel' has the reason" ;;
	*) printf 'agent running, connection not checked' ;;
	esac
}

report_tunnel() {
	printf 'Mode:      tunnel — TLS terminates at the edge, and %s\n' "$(origin_host "$1")"
	printf '           resolves there rather than to this box.\n'
	printf 'Tunnel:    %s\n' "$(tunnel_state)"
	printf 'Serving:   %s, over the public path through the edge\n' "$(serve_probe "$1")"
}

report_reachability() {
	_origin=$1
	[ -n "$_origin" ] || return 0
	if [ "$(get_var TLS_MODE)" = "tunnel" ]; then
		report_tunnel "$_origin"
		return 0
	fi
	_probe=$(probe_host "$_origin")
	_verdict=${_probe%% *}
	_addrs=${_probe#* }

	case "$_verdict" in
	unresolved)
		# Nothing to serve to, so there is nothing to probe either.
		printf 'Address:   %s does not resolve from this box — nothing loads there.\n' "$(origin_host "$_origin")"
		return 0
		;;
	elsewhere)
		printf 'Address:   %s\n' "$_addrs"
		printf '           This box does not hold that, so clients reach a different\n'
		printf '           machine, not this one.\n'
		# The probe follows the same name a browser does, so a healthy answer
		# came from that other machine. Saying so stops it reading as proof
		# this deployment is fine.
		printf 'Serving:   %s, at that address rather than here\n' "$(serve_probe "$_origin")"
		return 0
		;;
	loopback) printf 'Address:   %s — loopback, so reachable from this box only.\n' "$_addrs" ;;
	held) printf 'Address:   %s\n' "$_addrs" ;;
	*)
		if [ "$_addrs" = "$_verdict" ]; then
			printf 'Address:   not checked (no getent, dig or host on this box)\n'
		else
			printf 'Address:   %s\n' "$_addrs"
		fi
		;;
	esac
	printf 'Serving:   %s\n' "$(serve_probe "$_origin")"
}

cmd_status() {
	require_deployment
	_origin=$(get_var PUBLIC_ORIGIN)
	printf 'Directory: %s\n' "$REMIT_DIR"
	printf 'Tag:       %s\n' "$(get_var REMIT_TAG)"
	printf 'Origin:    %s\n' "$_origin"
	report_reachability "$_origin"
	read_update_record
	if [ -n "$UPDATE_RECORD_UNREADABLE" ]; then
		printf 'Updates:   unknown — the updater state volume (%s) could not be read\n' \
			"$(updater_state_volume)"
	else
		report_check "$UPDATE_CHECK_JSON"
		report_last_run "$UPDATE_RUN_JSON"
	fi
	printf '\n'
	compose ps
}

# --- self-update ------------------------------------------------------------
#
# RFC 037 D5, D6, D6a, D6b. `remit update` against a running stack is atomic:
# it snapshots the live databases before it stops anything, brings up a gate set
# that serves nobody, and either commits or restores the snapshot and the
# previous tag. There is one implementation of that sequence and this is it —
# the updater container (#133) runs this same wrapper, so an operator at a shell
# gets the same gate and the same rollback the app promises.
#
# Everything a run needs to survive its own death lives on the updater's volume:
# the lock, the breadcrumb, state.json and the snapshots. None of it goes in
# remit.db, because a rollback restores that file to before the run and would
# destroy the record of the rollback describing it.

RUN_ID=""
REQUESTED_RUN_ID=""
RUN_FROM=""
RUN_TARGET=""
RUN_STARTED=""
RUN_PHASE=""
RUN_SERVICES=""
RUN_MIGRATE_BEFORE=""
GATE_REASON=""
CHECK_VERSION=""
CHECK_AVAILABLE=""

epoch() { date -u +%s; }
iso_now() { date -u +%Y-%m-%dT%H:%M:%SZ; }

# Epoch seconds for the one timestamp shape written here and by the backend:
# ISO 8601, UTC, with an optional fractional part. `date` cannot do the reverse
# portably — GNU parses -d, busybox wants -D — so the conversion is arithmetic.
# Anything that is not that shape emits nothing, which every caller reads as no
# usable time rather than as an instant of its own.
iso_epoch() {
	printf '%s' "$1" | awk '
		/^[0-9][0-9][0-9][0-9]-[0-9][0-9]-[0-9][0-9]T[0-9][0-9]:[0-9][0-9]:[0-9][0-9]/ {
			rest = substr($0, 20)
			if (rest != "Z" && rest !~ /^\.[0-9]+Z$/) exit
			y = substr($0, 1, 4) + 0
			mo = substr($0, 6, 2) + 0
			d = substr($0, 9, 2) + 0
			h = substr($0, 12, 2) + 0
			mi = substr($0, 15, 2) + 0
			s = substr($0, 18, 2) + 0
			if (mo < 1 || mo > 12 || d < 1 || d > 31 || h > 23 || mi > 59 || s > 60) exit
			# Days from the civil date, Howard Hinnant era arithmetic: March-based
			# years make the leap day the last of the year, so no month table is
			# needed and every century rule falls out of the division.
			if (mo <= 2) y -= 1
			era = int((y >= 0 ? y : y - 399) / 400)
			yoe = y - era * 400
			mp = (mo + 9) % 12
			doy = int((153 * mp + 2) / 5) + d - 1
			doe = yoe * 365 + int(yoe / 4) - int(yoe / 100) + doy
			print (era * 146097 + doe - 719468) * 86400 + h * 3600 + mi * 60 + s
		}
	'
}

# The manifest URL is deployment configuration, so .env is where it lives; the
# environment overrides it for a one-off check against a different origin.
manifest_url() {
	if [ -n "${REMIT_UPDATE_MANIFEST_URL:-}" ]; then
		printf '%s' "$REMIT_UPDATE_MANIFEST_URL"
		return 0
	fi
	get_var REMIT_UPDATE_MANIFEST_URL 2>/dev/null || true
}

# Fixed-shape JSON built with printf is the whole strategy: there is no jq on a
# self-host box and every shape here is ours. Only the free-text fields need
# care, and only for quotes, backslashes and newlines.
json_escape() {
	printf '%s' "$1" | sed -e 's/\\/\\\\/g' -e 's/"/\\"/g' | tr '\n\r\t' '   '
}

# Reads one string field out of flat JSON. The manifest and the request file are
# both flat and both ours to define, which is what makes this enough.
json_string() {
	printf '%s' "$1" | tr '\n' ' ' |
		sed -n 's/.*"'"$2"'"[[:space:]]*:[[:space:]]*"\([^"]*\)".*/\1/p'
}

# Reads one integer field out of flat JSON. schemaVersion is a number, not the
# quoted string json_string reads, and an absent field yields nothing — an old
# manifest without it renders no schemaVersion at all rather than a zero.
json_number() {
	printf '%s' "$1" | tr '\n' ' ' |
		sed -n 's/.*"'"$2"'"[[:space:]]*:[[:space:]]*\([0-9][0-9]*\).*/\1/p'
}

# BRE alternation is a GNU extension, so this reads the two literals instead.
json_bool() {
	case "$(printf '%s' "$1" | tr '\n' ' ')" in
	*"\"$2\":true"* | *"\"$2\": true"*) printf 'true' ;;
	*) printf 'false' ;;
	esac
}

new_run_id() {
	_rand=$(od -An -N4 -tx1 /dev/urandom 2>/dev/null | tr -d ' \n')
	if [ -z "$_rand" ]; then _rand=$$; fi
	printf '%s-%s' "$(date -u +%Y%m%dT%H%M%SZ)" "$_rand"
}

# Write-temp-then-rename is atomic but not durable, and the breadcrumb is the
# whole recovery guarantee — a host that loses power after the stop has to find
# it. The parent directory needs the same treatment: the rename is what has to
# survive, not just the bytes.
fsync_path() {
	sync "$1" 2>/dev/null || sync
}

atomic_write() {
	rm -f "$1.tmp"
	(
		umask 077
		cat >"$1.tmp"
	)
	mv "$1.tmp" "$1"
}

# --- breadcrumb -------------------------------------------------------------

breadcrumb_write() {
	mkdir -p "$STATE_DIR"
	{
		printf 'runId=%s\n' "$RUN_ID"
		printf 'fromVersion=%s\n' "$RUN_FROM"
		printf 'targetVersion=%s\n' "$RUN_TARGET"
		printf 'startedAt=%s\n' "$RUN_STARTED"
		printf 'snapshot=%s\n' "$STATE_DIR/snapshots/$RUN_ID"
		printf 'services=%s\n' "$RUN_SERVICES"
		printf 'migrateBefore=%s\n' "$RUN_MIGRATE_BEFORE"
		printf 'phase=%s\n' "$RUN_PHASE"
	} | atomic_write "$STATE_DIR/breadcrumb"
	fsync_path "$STATE_DIR/breadcrumb"
	fsync_path "$STATE_DIR"
}

breadcrumb_get() {
	[ -f "$STATE_DIR/breadcrumb" ] || return 1
	_k=$1
	_k="$_k" awk '
		BEGIN { k = ENVIRON["_k"] }
		index($0, k "=") == 1 { print substr($0, length(k) + 2); exit }
	' "$STATE_DIR/breadcrumb"
}

breadcrumb_clear() {
	rm -f "$STATE_DIR/breadcrumb"
	fsync_path "$STATE_DIR"
}

# --- state.json -------------------------------------------------------------
#
# The check block and the run block are independent by construction — they are
# separate files composed into one document — so a failed check renders as a
# failed check and never as a failed update.
#
# phase is one of checking, pulling, snapshotting, stopping, starting,
# verifying, committing, rollingBack, recovering. outcome is null while a run is
# in flight, then succeeded, rolledBack, rollbackFailed, or abandoned — the last
# for a run that ended having changed nothing, which is what an interrupted or
# aborted run before the stop terminates as.

state_render() {
	mkdir -p "$STATE_DIR" "$CONTROL_DIR"
	_check='{"status":"disabled"}'
	if [ -f "$STATE_DIR/check.json" ]; then
		_check=$(cat "$STATE_DIR/check.json")
	fi
	_run=null
	if [ -f "$STATE_DIR/run.json" ]; then
		_run=$(cat "$STATE_DIR/run.json")
	fi
	# currentSchemaVersion is the running instance's schema version, recorded at
	# check time. Absent — never checked, or no database to read — is an unknown
	# version and the field is omitted rather than rendered null. A database that
	# exists but has not been migrated reads as 0, not absent.
	_schema=""
	if [ -f "$STATE_DIR/current-schema" ]; then
		_cs=$(cat "$STATE_DIR/current-schema")
		if [ -n "$_cs" ]; then
			_schema=$(printf ',"currentSchemaVersion":%s' "$_cs")
		fi
	fi
	printf '{"currentVersion":"%s"%s,"check":%s,"run":%s}\n' \
		"$(json_escape "$(get_var REMIT_TAG)")" "$_schema" "$_check" "$_run" |
		atomic_write "$CONTROL_DIR/state.json"
	# state.json carries no secret and the backend reads it back across the uid
	# boundary (the updater writes as root, the backend runs as 1000), so it is
	# made readable rather than left at atomic_write's 0600.
	chmod 0644 "$CONTROL_DIR/state.json" 2>/dev/null || true
}

# message and logCommand are rendered to the operator verbatim, so they are
# written as a sentence and as a command that can be pasted into a shell — not
# as debug output.
run_state_write() {
	_phase=$1
	_outcome=$2
	_message=$3
	_logcmd=$4
	mkdir -p "$STATE_DIR"
	_outjson=null
	if [ -n "$_outcome" ]; then
		_outjson=$(printf '"%s"' "$(json_escape "$_outcome")")
	fi
	printf '{"runId":"%s","fromVersion":"%s","targetVersion":"%s","phase":"%s","outcome":%s,"startedAt":"%s","updatedAt":"%s","message":"%s","logCommand":"%s"}\n' \
		"$(json_escape "$RUN_ID")" \
		"$(json_escape "$RUN_FROM")" \
		"$(json_escape "$RUN_TARGET")" \
		"$(json_escape "$_phase")" \
		"$_outjson" \
		"$(json_escape "$RUN_STARTED")" \
		"$(json_escape "$(iso_now)")" \
		"$(json_escape "$_message")" \
		"$(json_escape "$_logcmd")" |
		atomic_write "$STATE_DIR/run.json"
	state_render
}

phase() {
	RUN_PHASE=$1
	run_state_write "$1" "" "$2" "$3"
	breadcrumb_write
	if [ "${REMIT_QUIET:-0}" != "1" ]; then
		printf '%s\n' "$2"
	fi
}

terminate() {
	run_state_write "$RUN_PHASE" "$1" "$2" "$3"
	breadcrumb_clear
	if [ "${REMIT_QUIET:-0}" != "1" ]; then
		printf '%s\n' "$2"
	fi
}

# --- lock -------------------------------------------------------------------
#
# flock is the fast path: the kernel drops it when its holder dies, so a run
# killed at the stop leaves no lock and boot recovery proceeds for free. But that
# guarantee only holds while the holder is truly gone. A probe that wedged the
# updater (reader#284) kept an inherited lock fd open for hours, and a container
# stopped on some volume backends does not always release cleanly — either way
# the next run read "another update is already running" against a holder that was
# not (reader#285). So the lock also carries the holder's identity, and when the
# flock is held the acquirer places that holder alive or dead before it either
# refuses or reclaims. A reclaim is loud: it says whose lock it broke.

LOCK_FILE="$STATE_DIR/update.lock"

# Docker sets a container's hostname to its short id, which is the id every helper
# `docker run` reports and the one a foreign holder is inspected by; at a shell it
# is the machine's name, where the pid is what carries liveness instead.
in_container() {
	[ -f /.dockerenv ] && return 0
	grep -qaE '(docker|containerd|kubepods)' /proc/1/cgroup 2>/dev/null && return 0
	return 1
}

self_kind() {
	if in_container; then printf container; else printf shell; fi
}

self_host() {
	if [ -n "${HOSTNAME:-}" ]; then
		printf '%s' "$HOSTNAME"
		return 0
	fi
	hostname 2>/dev/null || printf unknown
}

lock_identity() {
	printf 'pid=%s\nkind=%s\ncontainer=%s\nstartedAt=%s\nepoch=%s\n' \
		"$$" "$(self_kind)" "$(self_host)" "$(iso_now)" "$(epoch)"
}

lock_field() {
	_lf=$1
	[ -f "$LOCK_FILE" ] || return 1
	_lf="$_lf" awk '
		BEGIN { k = ENVIRON["_lf"] }
		index($0, k "=") == 1 { print substr($0, length(k) + 2); exit }
	' "$LOCK_FILE"
}

# Names the recorded holder for a refusal or a reclaim, so neither is silent about
# who it found.
lock_owner_desc() {
	_od_pid=$(lock_field pid || true)
	_od_host=$(lock_field container || true)
	_od_at=$(lock_field startedAt || true)
	if [ -z "$_od_pid" ] && [ -z "$_od_host" ]; then
		printf 'an unidentified holder'
		return 0
	fi
	printf 'pid %s on %s (since %s)' "${_od_pid:-?}" "${_od_host:-?}" "${_od_at:-?}"
}

# Is the recorded holder provably gone? Conservative on purpose: only positive
# proof of death reclaims, so two updaters never run at once. A pid still present
# in this namespace, or a container the daemon reports running, is alive; a
# container the daemon reports stopped or absent, or a pid this namespace no
# longer has, is dead. When neither can be read — a legacy lock with no identity,
# or one whose holder died mid-write — the age is the last resort, and only an age
# past the ceiling counts as dead.
lock_holder_dead() {
	[ -f "$LOCK_FILE" ] || return 0
	_hk=$(lock_field kind || true)
	_hp=$(lock_field pid || true)
	_hc=$(lock_field container || true)
	if [ "$_hk" = "container" ] && [ -n "$_hc" ]; then
		# Capped, and death needs positive proof: a timed-out or erroring
		# daemon is indeterminate, and reclaiming on indeterminate would break
		# a live holder's lock.
		_hs=$(capped_run "$PROBE_RUN_TIMEOUT" docker inspect -f '{{.State.Running}}' "$_hc" 2>&1) || {
			case "$_hs" in
			*"No such object"*) return 0 ;;
			esac
			return 1
		}
		case "$_hs" in
		true) return 1 ;;
		false) return 0 ;;
		esac
	elif [ "$_hk" = "shell" ] && [ -n "$_hp" ]; then
		if kill -0 "$_hp" 2>/dev/null; then return 1; fi
		return 0
	fi
	_he=$(lock_field epoch || true)
	if [ -n "$_he" ] && [ "$(($(epoch) - _he))" -gt "$LOCK_STALE_CEILING" ]; then
		return 0
	fi
	return 1
}

lock_acquire() {
	mkdir -p "$STATE_DIR"
	have flock || die "flock is not on this box, and an update must not run without a lock.
Install util-linux (or busybox's flock) and try again."
	# A brief guard serialises acquisition and any reclaim, so two starts that both
	# find a dead holder cannot both break the lock. It is dropped the moment the
	# run's own lock (fd 9) is held — fd 9 is what carries mutual exclusion for the
	# whole run, and the kernel releases it when this process dies.
	exec 8>"$STATE_DIR/update.lock.guard"
	flock 8
	_reclaimed=""
	if [ -f "$LOCK_FILE" ]; then
		# Read+write without O_TRUNC, so probing the flock never erases a live
		# holder's identity.
		exec 9<>"$LOCK_FILE"
		if flock -n 9; then
			lock_identity >"$LOCK_FILE"
			exec 8>&-
			return 0
		fi
		if ! lock_holder_dead; then
			exec 9>&-
			exec 8>&-
			die "another update is already running on this box. Wait for it to finish, or see 'remit status'."
		fi
		_reclaimed=$(lock_owner_desc)
		# Break the stuck lock by replacing the inode: the dead holder's flock is on
		# the old, now-unlinked file, and every new acquirer races the fresh one
		# under the guard held above.
		exec 9>&-
		rm -f "$LOCK_FILE"
	fi
	exec 9>"$LOCK_FILE"
	if ! flock -n 9; then
		exec 8>&-
		die "the update lock could not be taken. See 'remit status'."
	fi
	lock_identity >"$LOCK_FILE"
	if [ -n "$_reclaimed" ] && [ "${REMIT_QUIET:-0}" != "1" ]; then
		printf '%s: reclaimed a stale update lock left by %s.\n' "$PROG" "$_reclaimed" >&2
	fi
	exec 8>&-
}

# --- manifest check (RFC 037 R4, R5) ----------------------------------------
#
# The manifest is the entire discovery mechanism. There is no registry tag
# listing, no "does this tag exist" probe and no fallback that reads the
# registry when the manifest is unreachable — image pushes are not atomic across
# the roster, so a tag can be present and pullable for a version that was never
# fully published and never can be. An unreachable manifest is a failed check
# and no update offered; it is never a reason to look somewhere else.

fetch_manifest() {
	if have curl; then
		curl -fsSL --max-time 20 --max-filesize 65536 "$1" 2>/dev/null
		return
	fi
	if have wget; then
		wget -q -T 20 -O - "$1" 2>/dev/null | head -c 65536
		return
	fi
	return 127
}

version_valid() {
	printf '%s' "$1" | grep -qE '^v[0-9]+\.[0-9]+\.[0-9]+$'
}

# An operator may pin a sha-<sha> build or `latest`; those are tags, not
# versions, and they are still allowed as an explicit --tag target. Anything
# outside this set never reaches a docker command line.
tag_valid() {
	printf '%s' "$1" | grep -qE '^[A-Za-z0-9][A-Za-z0-9._-]{0,127}$'
}

version_gt() {
	_a=${1#v}
	_b=${2#v}
	_i=1
	while [ "$_i" -le 3 ]; do
		_x=$(printf '%s' "$_a" | cut -d. -f"$_i")
		_y=$(printf '%s' "$_b" | cut -d. -f"$_i")
		if [ "$_x" -gt "$_y" ]; then return 0; fi
		if [ "$_x" -lt "$_y" ]; then return 1; fi
		_i=$((_i + 1))
	done
	return 1
}

# The tag-parameterised images — the ones a release actually moves. caddy and
# alpine are stock upstream images that a manifest has no say over.
release_images() {
	# shellcheck disable=SC2016 # ${REMIT_TAG} is compose's syntax, matched literally
	sed -n 's/^[[:space:]]*image:[[:space:]]*\(.*\)$/\1/p' "$REMIT_DIR/$COMPOSE_FILE" |
		grep '\${REMIT_TAG' |
		sed 's/:\${REMIT_TAG.*$//' |
		sort -u
}

images_under_registry() {
	_outside=$(release_images | grep -v "^$1/" || true)
	[ -z "$_outside" ]
}

check_failed() {
	printf '{"status":"failed","lastCheckedAt":"%s","error":"%s"}\n' \
		"$(iso_now)" "$(json_escape "$1")" | atomic_write "$STATE_DIR/check.json"
	state_render
	CHECK_VERSION=""
	CHECK_AVAILABLE=false
}

# Sets CHECK_VERSION and CHECK_AVAILABLE, and writes the check block. Returns
# non-zero only when the check itself failed — "no update available" is a
# successful check.
do_check() {
	mkdir -p "$STATE_DIR"
	record_current_schema
	CHECK_VERSION=""
	CHECK_AVAILABLE=false
	_url=$(manifest_url)
	if [ -z "$_url" ]; then
		printf '{"status":"disabled"}\n' | atomic_write "$STATE_DIR/check.json"
		state_render
		return 0
	fi
	_body=$(fetch_manifest "$_url" || true)
	if [ -z "$_body" ]; then
		check_failed "The update manifest at $_url could not be fetched."
		return 1
	fi
	_ver=$(json_string "$_body" version)
	_reg=$(json_string "$_body" registry)
	if ! version_valid "$_ver"; then
		check_failed "The update manifest at $_url does not name a vX.Y.Z version."
		return 1
	fi
	if [ -z "$_reg" ]; then
		check_failed "The update manifest at $_url does not name a registry."
		return 1
	fi
	if ! images_under_registry "$_reg"; then
		check_failed "This deployment runs images from outside $_reg, which the manifest does not cover."
		return 1
	fi
	_cur=$(get_var REMIT_TAG)
	# A tag that is not a version — `latest`, or a pinned sha- build — cannot be
	# compared, so the published release is offered rather than hidden.
	if ! version_valid "$_cur"; then
		CHECK_AVAILABLE=true
	elif version_gt "$_ver" "$_cur"; then
		CHECK_AVAILABLE=true
	fi
	CHECK_VERSION=$_ver
	write_check_ok "$(iso_now)" "$_ver" \
		"$(json_string "$_body" publishedAt)" \
		"$(json_string "$_body" summary)" \
		"$(json_string "$_body" releaseNotesUrl)" \
		"$CHECK_AVAILABLE" \
		"$(json_number "$_body" schemaVersion)"
	return 0
}

# schemaVersion ($7) is the target release's schema version, straight from the
# manifest. It is optional: a manifest without it produces a check block without
# it, which reads as an unknown schema version rather than a zero.
write_check_ok() {
	_schema=""
	if [ -n "${7:-}" ]; then
		_schema=$(printf ',"schemaVersion":%s' "$7")
	fi
	printf '{"status":"ok","lastCheckedAt":"%s","latestVersion":"%s","publishedAt":"%s","summary":"%s","releaseNotesUrl":"%s","updateAvailable":%s%s}\n' \
		"$(json_escape "$1")" \
		"$(json_escape "$2")" \
		"$(json_escape "$3")" \
		"$(json_escape "$4")" \
		"$(json_escape "$5")" \
		"$6" "$_schema" | atomic_write "$STATE_DIR/check.json"
	state_render
}

# updateAvailable is a statement about the version that is running, so a run
# that changed which version that is has to restate it. Nothing is fetched: the
# manifest said what the latest release is and that has not changed.
recheck_availability() {
	[ -f "$STATE_DIR/check.json" ] || return 0
	_c=$(cat "$STATE_DIR/check.json")
	[ "$(json_string "$_c" status)" = "ok" ] || return 0
	_latest=$(json_string "$_c" latestVersion)
	_cur=$(get_var REMIT_TAG)
	_avail=false
	if ! version_valid "$_cur"; then
		_avail=true
	elif version_gt "$_latest" "$_cur"; then
		_avail=true
	fi
	write_check_ok \
		"$(json_string "$_c" lastCheckedAt)" \
		"$_latest" \
		"$(json_string "$_c" publishedAt)" \
		"$(json_string "$_c" summary)" \
		"$(json_string "$_c" releaseNotesUrl)" \
		"$_avail" \
		"$(json_number "$_c" schemaVersion)"
}

# The control seam (#133): request.json is written wholly by the backend, so
# under a compromised backend its entire content is attacker-controlled — not
# only the field it is supposed to carry. It is a bounded, wholly-untrusted
# file. Oversized, it is rejected whole rather than truncated and parsed — a
# truncated parse is a partial honouring. Carrying any key beyond the four the
# backend writes, it is rejected whole rather than having the extras ignored. A
# registry, an image or a digest never crosses the seam because a file naming
# one is refused, not stripped. Two values are read: targetVersion, which still
# has to match vX.Y.Z *and* the manifest's own version before it is used, and
# runId, which becomes the run's own id so the page that asked for the update
# recognises the run it gets back (#583) — it names a snapshot directory, so it
# is held to a character set that cannot traverse or expand.
REQUEST_MAX_BYTES=4096
ALLOWED_REQUEST_KEYS=" runId targetVersion requestedAt requestedBy "

# requestedAt is load-bearing, not decoration (#587). A request is a person
# waiting at a screen, and the file outlives them: the updater can be stopped,
# idling on a failed preflight, or the whole box down, and the request is still
# on the seam when it comes back. Installing it then stops the stack on a day
# nobody asked for. Half an hour is longer than the app's overlay waits before
# it gives up, so no request anyone is still watching expires, and short enough
# that one found the next morning never installs. A request whose requestedAt is
# missing or unreadable is expired by the same rule: an absent timestamp is
# exactly the pre-#587 request this window exists to catch, and there is nothing
# in it to show the request is anyone's.
REQUEST_MAX_AGE_SECONDS=1800

# Emits each top-level key of a flat JSON object, one per line, tracking string
# escapes and depth so a value that contains `":` does not read as a key. Any
# nesting, or an array, emits the sentinel __INVALID__ — which is not a
# whitelisted key, so the caller rejects the whole file. This is deliberately
# stricter than a JSON parser: the request is a flat object of strings and
# anything else is refused.
#
# The object is the whole file, not a fragment of it, and every key it holds is
# a key the file declared (#241). Outside a string only four things are legal:
# the one object, the punctuation between its members, whitespace, and nothing
# else. So a token before the opening brace, a token after the closing one, a
# second object, and a member the file ran together with the one before it
# because it carried no comma, are all the same refusal. A parse that reads to
# the first closing brace and stops, or that skips from a value straight into
# the next quoted key, reads only the half an attacker wants read.
request_keys() {
	printf '%s' "$1" | tr '\n\r' '  ' | awk '
		{
			s = $0
			n = length(s)
			depth = 0; instr = 0; esc = 0; expectkey = 0
			collecting = 0; key = ""; invalid = 0; closed = 0; wantsep = 0
			for (i = 1; i <= n; i++) {
				c = substr(s, i, 1)
				if (instr) {
					if (esc) { esc = 0; if (collecting) key = key c; continue }
					if (c == "\\") { esc = 1; if (collecting) key = key c; continue }
					if (c == "\"") {
						instr = 0
						if (collecting) { print key; collecting = 0; key = "" }
						else { wantsep = 1 }
						continue
					}
					if (collecting) key = key c
					continue
				}
				if (c == " " || c == "\t") { continue }
				if (depth == 0 && (closed || c != "{")) { invalid = 1; break }
				if (wantsep && c != "," && c != "}") { invalid = 1; break }
				if (c == "\"") {
					instr = 1
					if (depth == 1 && expectkey) { collecting = 1; key = ""; expectkey = 0 }
					continue
				}
				if (c == "{") { depth++; if (depth == 1) { expectkey = 1 } else { invalid = 1 } ; continue }
				if (c == "[") { invalid = 1; continue }
				if (c == "}") { depth--; wantsep = 0; if (depth == 0) { closed = 1 } ; continue }
				if (c == "]") { invalid = 1; continue }
				if (c == "," && depth == 1) { expectkey = 1; wantsep = 0; continue }
				if (c == ":" && depth == 1) { continue }
				invalid = 1; break
			}
			if (invalid || depth != 0) print "__INVALID__"
		}
	'
}

request_run_id_valid() {
	printf '%s' "$1" | grep -qE '^[A-Za-z0-9][A-Za-z0-9-]{0,63}$'
}

request_age_seconds() {
	_at=$(iso_epoch "$(json_string "$1" requestedAt)")
	[ -n "$_at" ] || return 1
	printf '%s' "$(($(epoch) - _at))"
}

# Emits the accepted target version, and the run id the request named on a
# second line — empty when the request carried none. Both are refused together:
# a request whose runId is unusable is rejected whole, like every other
# malformed field, rather than being run under an id of our own.
#
# Status 2 is the one refusal the caller reports rather than swallows: the file
# was well-formed and simply too old. It is tested before the version, because
# a request left on the seam for days is stale whether or not a newer release
# has since shipped, and "this is not the published release" is the wrong thing
# to tell an operator whose real problem is an updater that was not running.
requested_target() {
	[ -f "$CONTROL_DIR/request.json" ] || return 1
	_bytes=$(wc -c <"$CONTROL_DIR/request.json" 2>/dev/null || printf '%s' "$((REQUEST_MAX_BYTES + 1))")
	if [ "$_bytes" -gt "$REQUEST_MAX_BYTES" ]; then
		return 1
	fi
	_raw=$(cat "$CONTROL_DIR/request.json")
	_saw_target=0
	_saw_run=0
	while IFS= read -r _k; do
		[ -n "$_k" ] || continue
		case "$ALLOWED_REQUEST_KEYS" in
		*" $_k "*) ;;
		*) return 1 ;;
		esac
		if [ "$_k" = "targetVersion" ]; then _saw_target=1; fi
		if [ "$_k" = "runId" ]; then _saw_run=1; fi
	done <<EOF
$(request_keys "$_raw")
EOF
	[ "$_saw_target" = "1" ] || return 1
	# Bounded from below as well as above. A stamp in this instance's future was
	# not written against this clock, and a box with no RTC is exactly where that
	# happens: it comes up reading roughly its own shutdown time, so a request
	# written just before the stop looks minutes old days later. Without the
	# floor, the surviving-a-`remit stop` case #587 names is the one the window
	# misses.
	_age=$(request_age_seconds "$_raw") || return 2
	if [ "$_age" -lt 0 ] || [ "$_age" -gt "$REQUEST_MAX_AGE_SECONDS" ]; then
		return 2
	fi
	_want=$(json_string "$_raw" targetVersion)
	if ! version_valid "$_want"; then
		return 1
	fi
	if [ "$_want" != "$CHECK_VERSION" ]; then
		return 1
	fi
	_run=""
	if [ "$_saw_run" = "1" ]; then
		_run=$(json_string "$_raw" runId)
		if ! request_run_id_valid "$_run"; then
			return 1
		fi
	fi
	printf '%s\n%s' "$_want" "$_run"
}

# An expired request is discarded, and the discard is recorded as a run that
# changed nothing. Silence here would trade a surprise install for a surprise
# no-op: run.json is what `remit status` and the app both read, so it is the
# only place the operator can learn that an install was asked for and not
# performed. The run keeps the id the request named, so a page still polling
# gets a verdict on its own run rather than never hearing back. Nothing out of
# the file reaches the message unvalidated — the version is rendered only if it
# is a version, the time only if it is a time.
discard_expired_request() {
	RUN_ID=$(json_string "$1" runId)
	if ! request_run_id_valid "$RUN_ID"; then
		RUN_ID=$(new_run_id)
	fi
	RUN_FROM=$(get_var REMIT_TAG)
	RUN_TARGET=$(json_string "$1" targetVersion)
	version_valid "$RUN_TARGET" || RUN_TARGET=""
	RUN_STARTED=$(iso_now)
	RUN_PHASE=checking
	_at=$(json_string "$1" requestedAt)
	_atsec=$(iso_epoch "$_at")
	if [ -z "$_atsec" ]; then
		_why="carried no time it was made"
	elif [ "$_atsec" -gt "$(epoch)" ]; then
		_why="is stamped $_at, which is ahead of this instance's own clock"
	else
		_why="was made at $_at, longer ago than the $((REQUEST_MAX_AGE_SECONDS / 60)) minutes a request stays current"
	fi
	mkdir -p "$STATE_DIR"
	terminate abandoned \
		"The update request on the control volume $_why, so it was discarded rather than installed; this instance is still running $RUN_FROM. Ask for the update again to install it now." \
		"$PROG update"
}

# --- snapshot and restore (RFC 037 R8, R8a) ---------------------------------
#
# The databases live on a named volume, so both directions run in a container
# that mounts it. queue.db is on a different volume and is not mounted here at
# all: restoring a work queue resurrects already-delivered outbound mail, which
# is a correctness bug rather than a cost. Nothing in the gate window writes it,
# so leaving it alone is right in both directions.

# Every helper `docker run` goes through here, so none can outlive its phase.
# timeout is the parent, not a flag inside the container, because the failure it
# guards against is the container never returning at all — an entrypoint that
# ignores its command, or a daemon that stops answering. Its exit status is the
# command's, so callers read a real pass or fail; a deadline hit surfaces as
# timeout's own non-zero, which every caller already treats as failure.
capped_run() {
	_crt=$1
	shift
	if have timeout; then
		timeout "$_crt" "$@"
		return $?
	fi
	"$@"
}

# The volume the databases live on. Compose names it after the project, so a
# second deployment's snapshot and restore reach its own data rather than
# creating an empty volume beside it.
sqlite_volume() {
	if [ -n "${REMIT_UPDATE_SQLITE_VOLUME:-}" ]; then
		printf '%s' "$REMIT_UPDATE_SQLITE_VOLUME"
		return 0
	fi
	printf '%s_sqlite_data' "$(compose_project)"
}

# The volume the updater keeps its own state on — the lock, the breadcrumb, the
# snapshots, check.json and run.json. Compose names it after the project, the
# same way it names the database volume. Inside the updater this is where
# STATE_DIR already points; from a host shell it is the only way to reach it.
updater_state_volume() {
	if [ -n "${REMIT_UPDATE_STATE_VOLUME:-}" ]; then
		printf '%s' "$REMIT_UPDATE_STATE_VOLUME"
		return 0
	fi
	printf '%s_updater_state' "$(compose_project)"
}

# One flat file off that volume, for a shell that cannot reach it directly. The
# `|| true` runs inside the container so an absent file and a docker that never
# answered are not the same empty string: only the second one fails, and the
# caller can say so instead of reporting a box that has never checked.
updater_state_file() {
	capped_run "$HELPER_RUN_TIMEOUT" docker run --rm \
		-v "$(updater_state_volume):/state" \
		--entrypoint sh "$HELPER_IMAGE" \
		-c "cat /state/$1 2>/dev/null || true" 2>/dev/null
}

volume_run() {
	_vr_script=$1
	set -- \
		-v "$(sqlite_volume):/data/sqlite" \
		-v "$STATE_MOUNT:/state"
	if [ -n "$SNAPSHOT_LIB_MOUNT" ]; then
		set -- "$@" -v "$SNAPSHOT_LIB_MOUNT:/snapshot-db.sh:ro"
	fi
	capped_run "$HELPER_RUN_TIMEOUT" docker run --rm "$@" --entrypoint sh "$HELPER_IMAGE" -c "$_vr_script"
}

# VACUUM INTO against the live databases, before anything is stopped. sqlite3 is
# apk'd the way the backup sidecar already does; the snapshot runs as uid 1000
# because opening a WAL database recreates its -shm/-wal sidecars when they are
# absent, and a root-owned sidecar makes every app writer's next open fail.
snapshot_databases() {
	volume_run "set -eu
command -v sqlite3 >/dev/null 2>&1 || apk add --no-cache sqlite >/dev/null
command -v su-exec >/dev/null 2>&1 || apk add --no-cache su-exec >/dev/null
mkdir -p /state/snapshots/$1
chown 1000:1000 /state/snapshots/$1
exec su-exec 1000:1000 sh -c '. /snapshot-db.sh
snapshot_db /data/sqlite/remit.db /state/snapshots/$1/remit.db
snapshot_db /data/sqlite/vec.db /state/snapshots/$1/vec.db'"
}

# Installs nothing: a rollback must not depend on the network whose failure it
# may be recovering from. The unlinks are not tidiness — VACUUM INTO writes a
# fresh file with its own salt, so a WAL left behind by the stop is a mismatched
# sidecar beside a database that never wrote it. The chown is what keeps a
# successful rollback from terminating as rollbackFailed: the updater is root,
# every app container is uid 1000, and a root-owned file on that volume fails
# the gate re-run with EACCES.
restore_snapshot() {
	volume_run "set -eu
snap=/state/snapshots/$1
if [ ! -f \"\$snap/remit.db\" ]; then
  echo 'the snapshot for this run is missing' >&2
  exit 1
fi
rm -f /data/sqlite/remit.db /data/sqlite/remit.db-wal /data/sqlite/remit.db-shm
cp \"\$snap/remit.db\" /data/sqlite/remit.db
if [ -f \"\$snap/vec.db\" ]; then
  rm -f /data/sqlite/vec.db /data/sqlite/vec.db-wal /data/sqlite/vec.db-shm
  cp \"\$snap/vec.db\" /data/sqlite/vec.db
fi
chown -R 1000:1000 /data/sqlite"
}

prune_snapshots() {
	[ -d "$STATE_DIR/snapshots" ] || return 0
	for _d in "$STATE_DIR/snapshots"/*; do
		[ -d "$_d" ] || continue
		_name=${_d##*/}
		if [ "$_name" != "$1" ]; then
			rm -rf "$_d"
		fi
	done
}

# --- running schema version (reader#242) ------------------------------------
#
# The instance's schema version is how many migrations have been applied, read
# from drizzle's own bookkeeping tables in the live database. The manifest's
# schemaVersion is the same count at the target release (npm-scripts derives it
# from the migration journals), so schemaVersion > currentSchemaVersion is
# exactly "installing this release runs a migration" — no boolean is computed or
# stored anywhere.
#
# It reads inside a helper container the way the snapshot does, and as uid 1000
# for the same reason: a consistent count opens the live WAL database, and a
# root-owned -wal/-shm sidecar left on the volume fails every app writer's next
# open. An absent database is an unknown version — it prints nothing and is
# never an error. A database that exists but holds none of the migration tables
# is schema version 0, a pre-migration instance that every release migrates:
# counting a table that does not exist yields 0 through the sqlite3 fallback,
# and that zero total is emitted rather than folded back into unknown.
read_schema_version() {
	volume_run "set -eu
command -v sqlite3 >/dev/null 2>&1 || apk add --no-cache sqlite >/dev/null 2>&1 || exit 0
command -v su-exec >/dev/null 2>&1 || apk add --no-cache su-exec >/dev/null 2>&1 || exit 0
[ -f /data/sqlite/remit.db ] || exit 0
exec su-exec 1000:1000 sh -c 'total=0
for t in __drizzle_migrations_entities __drizzle_migrations_auth __drizzle_migrations_meta; do
  c=\$(sqlite3 /data/sqlite/remit.db \"SELECT count(*) FROM \$t\" 2>/dev/null || printf 0)
  total=\$((total + c))
done
printf %s \"\$total\"'"
}

# Persisted so state_render can render it on every later write without opening a
# container each time; refreshed on each check. A non-integer read — the helper
# failed, the database is not there — clears it, so the field goes back to
# unknown rather than reporting a stale version. Only do_check calls this, so
# after an update migrates the database the recorded version stays at the
# pre-update count until the next check refreshes it; that self-heals, and
# updateAvailable is false in the interim, so no consumer is misled.
record_current_schema() {
	_sv=$(read_schema_version 2>/dev/null || true)
	if printf '%s' "$_sv" | grep -qE '^[0-9]+$'; then
		printf '%s' "$_sv" | atomic_write "$STATE_DIR/current-schema"
	else
		rm -f "$STATE_DIR/current-schema"
	fi
}

# --- the gate (RFC 037 D5, R9) ----------------------------------------------
#
# All four conditions within the budget, against a stack that is serving nobody.
# A return of 2 from a condition is terminal — waiting cannot change it — and 1
# means not yet.

service_cid() {
	compose ps -aq "$1" 2>/dev/null | tail -1
}

gate_baseline() {
	: >"$STATE_DIR/gate-baseline"
	for _svc in $GATE_SERVICES; do
		_cid=$(service_cid "$_svc")
		_rc=0
		if [ -n "$_cid" ]; then
			_rc=$(docker inspect -f '{{.RestartCount}}' "$_cid" 2>/dev/null || printf 0)
		fi
		printf '%s %s\n' "$_svc" "$_rc" >>"$STATE_DIR/gate-baseline"
	done
}

baseline_of() {
	_v=$(awk -v s="$1" '$1 == s { print $2; exit }' "$STATE_DIR/gate-baseline" 2>/dev/null || true)
	if [ -z "$_v" ]; then _v=0; fi
	printf '%s' "$_v"
}

# Condition 1. The container id has to have changed across the recreate before
# the exit code counts: reading whatever `compose ps -aq migrate` finds is
# satisfied by the previous run's exited container, so a recreate that silently
# no-ops would read an old success and pass an update whose migration never ran.
gate_migrate() {
	_cid=$(service_cid migrate)
	if [ -z "$_cid" ]; then
		GATE_REASON="the database migration never ran"
		return 2
	fi
	if [ -n "$1" ] && [ "$_cid" = "$1" ]; then
		GATE_REASON="the database migration did not run — its container was never replaced"
		return 2
	fi
	_status=$(docker inspect -f '{{.State.Status}}' "$_cid" 2>/dev/null || printf unknown)
	if [ "$_status" != "exited" ]; then
		GATE_REASON="the database migration has not finished"
		return 1
	fi
	_code=$(docker inspect -f '{{.State.ExitCode}}' "$_cid" 2>/dev/null || printf 1)
	if [ "$_code" != "0" ]; then
		GATE_REASON="the database migration failed (exit $_code)"
		return 2
	fi
	return 0
}

# Condition 2. A restart count that moved means the service exited and came back
# — a crash loop, which waiting cannot fix.
gate_running() {
	for _svc in $GATE_SERVICES; do
		_cid=$(service_cid "$_svc")
		if [ -z "$_cid" ]; then
			GATE_REASON="$_svc is not running"
			return 1
		fi
		_running=$(docker inspect -f '{{.State.Running}}' "$_cid" 2>/dev/null || printf false)
		if [ "$_running" != "true" ]; then
			GATE_REASON="$_svc is not running"
			return 1
		fi
		_rc=$(docker inspect -f '{{.RestartCount}}' "$_cid" 2>/dev/null || printf 0)
		if [ "$_rc" -gt "$(baseline_of "$_svc")" ]; then
			GATE_REASON="$_svc keeps restarting"
			return 2
		fi
	done
	return 0
}

# Condition 3. Services without a healthcheck report none and pass; the
# healthchecks that make this more than "the port answers" are on backend,
# apisix and web.
gate_healthy() {
	for _svc in $GATE_SERVICES; do
		_cid=$(service_cid "$_svc")
		if [ -z "$_cid" ]; then
			GATE_REASON="$_svc is not running"
			return 1
		fi
		_h=$(docker inspect -f '{{if .State.Health}}{{.State.Health.Status}}{{else}}none{{end}}' "$_cid" 2>/dev/null || printf unknown)
		case "$_h" in
		none | healthy) ;;
		*)
			GATE_REASON="$_svc is not healthy ($_h)"
			return 1
			;;
		esac
	done
	return 0
}

# Condition 4. The backend directly: APISIX is held down for the whole window,
# so there is nothing else to ask. Joining the backend's own network namespace
# avoids having to know what the compose network is called, and fails by itself
# when the backend has no container.
#
# --entrypoint wget, always, and the id resolved here rather than captured
# earlier: without the explicit entrypoint the updater image runs its own
# ENTRYPOINT and the wget arguments become ignored daemon arguments, so the probe
# container never exits and the whole verify hangs (reader#284). capped_run bounds
# the `docker run` from outside; wget's own -T only ever bounded the request.
probe_backend() {
	_cid=$(compose ps -q backend 2>/dev/null | tail -1)
	if [ -z "$_cid" ]; then
		return 1
	fi
	capped_run "$PROBE_RUN_TIMEOUT" docker run --rm --network "container:$_cid" \
		--entrypoint wget "$HELPER_IMAGE" \
		-q -T 5 -O /dev/null http://127.0.0.1:8080/health >/dev/null 2>&1
}

run_gate() {
	_migrate_before=$1
	GATE_REASON="the new version did not answer within ${GATE_BUDGET_SECONDS}s"
	_deadline=$(($(epoch) + GATE_BUDGET_SECONDS))
	_probes=0
	while :; do
		_rc=0
		gate_migrate "$_migrate_before" || _rc=$?
		if [ "$_rc" = "0" ]; then
			_rc=0
			gate_running || _rc=$?
		fi
		if [ "$_rc" = "0" ]; then
			_rc=0
			gate_healthy || _rc=$?
		fi
		if [ "$_rc" = "2" ]; then
			return 1
		fi
		if [ "$_rc" = "0" ]; then
			if probe_backend; then
				_probes=$((_probes + 1))
				if [ "$_probes" -ge 3 ]; then
					GATE_REASON=""
					return 0
				fi
			else
				_probes=0
				GATE_REASON="the new backend did not answer /health"
			fi
		else
			_probes=0
		fi
		if [ "$(epoch)" -ge "$_deadline" ]; then
			return 1
		fi
		sleep "$GATE_PROBE_INTERVAL"
	done
}

# --- the sequence -----------------------------------------------------------

stack_is_running() {
	_n=$(compose ps -q 2>/dev/null | wc -l)
	[ "$_n" -gt 0 ]
}

# Whether this deployment has anything to lose. `remit down` leaves the
# databases where they are, so process state answers a different question: a
# stopped box can still hold every account and message on the volume. Read
# through the same mount the snapshot binds, so both are answering for the same
# data, and the statement read is the one the rollback depends on — a snapshot
# without a remit.db in it is what restore_snapshot refuses, so anything else
# here would route a run into a rollback it cannot perform.
#
# 0 is a database with bytes in it, 1 a volume without one, and 2 a probe that
# did not run at all: no daemon, no image, a timeout. That third answer is not a
# reading and must never be guessed into one — either guess is wrong, one
# migrating an unprotected database and the other snapshotting a volume that has
# nothing on it — so the caller refuses the update instead.
deployment_data_state() {
	_dds=0
	volume_run "set -eu
if [ -s /data/sqlite/remit.db ]; then exit 0; fi
exit 3" >/dev/null 2>&1 || _dds=$?
	case "$_dds" in
	0) return 0 ;;
	3) return 1 ;;
	esac
	return 2
}

running_services() {
	compose ps --services --status running 2>/dev/null | grep -vx updater | tr '\n' ' '
}

# The always-on stack as the compose file defines it — what an unscoped
# `compose up -d` starts — minus the updater, which drives the update and
# replaces itself last. Never a list written out here: one name this project
# no longer declares refuses the whole `up` it is passed to (reader#412).
all_services() {
	compose config --services 2>/dev/null | grep -vx updater | tr '\n' ' '
}

# --- bind-path identity (reader#272) ----------------------------------------
#
# Socket-driven compose resolves this file's relative binds against the project
# directory as a *host* path. In the updater that only holds when the deployment
# directory is mounted at the same absolute path the host knows it by; a mismatch
# has the daemon create a root-owned directory on the host where ./queues.json
# should be a file, and the stack crash-loops with EISDIR. Prove the identity
# before serving anything: the project directory has to hold the compose file,
# and a marker written into it here has to come back through the daemon at the
# same path — the exact resolution a relative bind gets. A wrong or missing mount
# fails this at boot, never at update time.
assert_bind_identity() {
	[ -f "$REMIT_DIR/$COMPOSE_FILE" ] || return 1
	_id_marker="$REMIT_DIR/.remit-mount-identity"
	_id_token="identity-$(epoch)-$$"
	printf '%s' "$_id_token" >"$_id_marker" 2>/dev/null || return 1
	# Written as root in the updater; inherit the deployment directory's owner so
	# a marker that outlives an interrupted preflight is not a stray root-owned
	# file in the operator's directory (reader#273). The directory's uid:gid, not
	# its mode — the marker is transient and its own mode does not matter.
	restore_owner_mode "$_id_marker" "$(stat -c '%u %g' "$REMIT_DIR" 2>/dev/null || stat -f '%u %g' "$REMIT_DIR" 2>/dev/null)"
	_id_seen=$(capped_run "$HELPER_RUN_TIMEOUT" docker run --rm -v "$REMIT_DIR:$REMIT_DIR" --entrypoint sh "$HELPER_IMAGE" \
		-c "cat '$REMIT_DIR/.remit-mount-identity' 2>/dev/null" 2>/dev/null || true)
	rm -f "$_id_marker"
	[ "$_id_seen" = "$_id_token" ]
}

# Every service except the updater and caddy, by name. Never a bare
# `compose stop`: in the updater container that stops the very service this code
# runs in, and `restart: unless-stopped` does not resurrect an explicitly-stopped
# container — the run dies with the site down and no process left to finish or
# roll back (reader#271). The updater is excluded here for the same reason the
# gate and come-up sets never name it: it drives the update and replaces itself
# last.
#
# caddy is excluded too, and stays up across the whole window. It is not
# version-pinned and holds no app volume, so nothing collides by leaving it
# running; its reverse_proxy already re-dials a swapped upstream for
# lb_try_duration (caddy/routes.caddy), so a request that lands while the app
# plane is down is held and served once the new stack answers rather than
# meeting a refused connection. Stopping it was the whole of the visible outage:
# the front door went dark for the entire stop→healthy window.
#
# tunnel is excluded for the same reason, and only exists under TLS_MODE=tunnel
# (COMPOSE_PROFILES). It is the edge in that mode: caddy has nothing to answer
# with if the cloudflared agent holding the connection to Cloudflare's edge goes
# down, so the operator's browser gets a 530 from Cloudflare itself rather than
# a held request from caddy (reader#762). Same reasoning as caddy — stock image,
# no app volume, nothing collides by leaving it running across the window.
#
# Two passes, because the stop set is not one list. `compose config --services`
# names the always-on services; `backup` sits behind an inactive profile and is
# only seen by `ps`, yet it must stop too — it is a stock alpine image under
# `restart: unless-stopped` that opens remit.db read-write every interval, a
# collision during the restore.
stop_everything() {
	_stopset=$(compose config --services 2>/dev/null | grep -vxE 'updater|caddy|tunnel' | tr '\n' ' ')
	if [ -n "$_stopset" ]; then
		# shellcheck disable=SC2086 # a service list, split on purpose
		compose stop $_stopset
	fi
	_left=$(compose ps --services --status running 2>/dev/null | grep -vxE 'updater|caddy|tunnel' | tr '\n' ' ')
	if [ -n "$_left" ]; then
		# shellcheck disable=SC2086 # a service list, split on purpose
		compose stop $_left
	fi
}

start_gate_set() {
	# The cid is read once per run, at the first start, and carried from there —
	# through the breadcrumb into a recovery, and into a rollback. Compose leaves
	# an already-recreated one-shot alone when nothing in the configuration
	# moved, so a second read after an interruption hands the gate the same cid
	# on both sides and rolls a migrated release back over its own database.
	# `none` is the reading taken when there was no migrate container at all: a
	# value, so a later run can tell it from never having looked.
	if [ -z "$RUN_MIGRATE_BEFORE" ]; then
		RUN_MIGRATE_BEFORE=$(service_cid migrate)
		if [ -z "$RUN_MIGRATE_BEFORE" ]; then RUN_MIGRATE_BEFORE=none; fi
	fi
	breadcrumb_write
	# shellcheck disable=SC2086 # GATE_SET is a service list, split on purpose
	compose up -d $GATE_SET
	gate_baseline
}

# `compose up -d` exiting 0 is not the same as the services being there
# afterwards, and on a box that was down this is the whole always-on stack —
# caddy included, whose :80 and :443 something else may have taken while the box
# was stopped. So what came back is read rather than assumed, the way the
# profile restore reads it.
#
# The gate has already spoken by the time this runs and its verdict stands: the
# tag and the database are in place, and only the app plane is missing. That is
# exactly the state recover_run's committing branch is written for, so this says
# which services are missing and points at it. Terminating instead would record
# a verdict on the update that the gate already answered, and returning non-zero
# would trip set -e at the call site with nothing said at all.
start_held_back() {
	if [ -z "$RUN_SERVICES" ]; then
		return 0
	fi
	# shellcheck disable=SC2086 # the recorded service list, split on purpose
	compose up -d $RUN_SERVICES || true
	_held_down=$(stopped_among "$(services_not_in "$RUN_SERVICES" "$ONE_SHOT_SERVICES")")
	if [ -n "$_held_down" ]; then
		die "these services did not start: ${_held_down% }. This instance is on $(get_var REMIT_TAG) with its database in place, so nothing is lost — something is holding them down, a port already taken by another process being the usual one. Check '$PROG logs', clear what is in the way, then run '$PROG update --recover' to finish."
	fi
}

# The self-replace recreates the updater service, and compose kills the container
# this wrapper runs in as it does. Issued from this process, the recreate dies
# half-done and leaves the replacement `Created` under a temp name with no updater
# running (reader#291). So it is handed to a detached one-shot container that
# outlives this one: it recreates the updater and records the swap on the state
# volume. The verdict is already durable before any of this, so being killed the
# instant the detached helper reaches the recreate loses nothing.
UPDATER_RECREATE_ISSUED=0

updater_handoff_write() {
	mkdir -p "$STATE_DIR"
	rm -f "$STATE_DIR/updater-handoff.done"
	{
		printf 'runId=%s\n' "$RUN_ID"
		printf 'tag=%s\n' "$(get_var REMIT_TAG)"
		printf 'at=%s\n' "$(iso_now)"
	} | atomic_write "$STATE_DIR/updater-handoff"
	fsync_path "$STATE_DIR/updater-handoff"
	fsync_path "$STATE_DIR"
}

updater_handoff_field() {
	_uf=$1
	[ -f "$STATE_DIR/updater-handoff" ] || return 1
	_uf="$_uf" awk '
		BEGIN { k = ENVIRON["_uf"] }
		index($0, k "=") == 1 { print substr($0, length(k) + 2); exit }
	' "$STATE_DIR/updater-handoff"
}

# The detached container recreates the updater and, on success, drops the done
# marker on the shared state volume — /state here is the same storage the updater
# reads as STATE_DIR, so the marker lands where a later boot recover looks. The
# helper mounts the docker socket because it drives compose, not a volume;
# --entrypoint sh per reader#284; -d so it survives this container's replacement.
launch_updater_recreate() {
	_ur_script="docker compose --project-directory '$REMIT_DIR' -f '$REMIT_DIR/$COMPOSE_FILE' --env-file '$REMIT_DIR/.env' up -d updater && : >/state/updater-handoff.done"
	capped_run "$HELPER_RUN_TIMEOUT" docker run -d --rm \
		-v "$DOCKER_SOCKET:/var/run/docker.sock" \
		-v "$REMIT_DIR:$REMIT_DIR" \
		-v "$STATE_MOUNT:/state" \
		--entrypoint sh "$HELPER_IMAGE" -c "$_ur_script" >/dev/null 2>&1 || true
	UPDATER_RECREATE_ISSUED=1
}

replace_updater() {
	compose config --services 2>/dev/null | grep -qx updater || return 0
	updater_handoff_write
	launch_updater_recreate
}

# Run at boot, after recover_run. A handoff left from a previous boot means the
# updater's own last act was to hand its recreate to a detached helper; that this
# fresh updater is running to read it is itself proof the recreate reached a
# started container. A done marker confirms the helper saw compose succeed. With
# neither — the helper never recorded success — the recreate is re-issued so the
# service matches its definition, then the handoff is cleared; a later boot
# re-running this finds nothing to do. Skipped when this same boot just issued a
# handoff of its own (a recovered run that committed), which has nothing prior to
# verify.
verify_updater_handoff() {
	[ "$UPDATER_RECREATE_ISSUED" = "1" ] && return 0
	[ -f "$STATE_DIR/updater-handoff" ] || return 0
	_hrun=$(updater_handoff_field runId || true)
	_htag=$(updater_handoff_field tag || true)
	if [ -f "$STATE_DIR/updater-handoff.done" ]; then
		if [ "${REMIT_QUIET:-0}" != "1" ]; then
			printf '%s: the updater self-replace for %s (%s) completed.\n' "$PROG" "$_hrun" "$_htag"
		fi
		rm -f "$STATE_DIR/updater-handoff" "$STATE_DIR/updater-handoff.done"
		fsync_path "$STATE_DIR"
		return 0
	fi
	if [ "${REMIT_QUIET:-0}" != "1" ]; then
		printf '%s: finishing an unconfirmed updater self-replace for %s (%s).\n' "$PROG" "$_hrun" "$_htag"
	fi
	if compose config --services 2>/dev/null | grep -qx updater; then
		launch_updater_recreate
	fi
	rm -f "$STATE_DIR/updater-handoff" "$STATE_DIR/updater-handoff.done"
	fsync_path "$STATE_DIR"
}

commit_run() {
	phase committing "Starting the rest of the services." "remit logs"
	start_held_back
	# This run's snapshot and the previous release's images are retained until
	# the next successful update; every earlier run's snapshot goes.
	prune_snapshots "$RUN_ID"
	recheck_availability
	terminate succeeded "This instance is now running $RUN_TARGET." "remit logs backend"
	replace_updater
}

roll_back() {
	_why=$1
	phase rollingBack "$_why. Restoring $RUN_FROM and the database as it was before the update." "remit logs backend"
	stop_everything
	if ! restore_snapshot "$RUN_ID"; then
		terminate rollbackFailed \
			"$_why, and the database snapshot could not be restored. The snapshot is at $STATE_DIR/snapshots/$RUN_ID and the previous version is $RUN_FROM." \
			"remit logs backend"
		return 1
	fi
	set_var REMIT_TAG "$RUN_FROM"
	REMIT_TAG=$RUN_FROM
	export REMIT_TAG
	recheck_availability
	start_gate_set
	if run_gate "$RUN_MIGRATE_BEFORE"; then
		start_held_back
		prune_snapshots "$RUN_ID"
		terminate rolledBack \
			"$_why. This instance was restored to $RUN_FROM and is serving again." \
			"remit logs backend"
		replace_updater
		return 0
	fi
	terminate rollbackFailed \
		"$_why, and $RUN_FROM did not come back either ($GATE_REASON). The snapshot taken before the update is at $STATE_DIR/snapshots/$RUN_ID." \
		"remit logs backend"
	return 1
}

run_update() {
	_target=$1
	# A backend-initiated run keeps the id the request named, so the page that
	# asked for it can tell its own run from a later one; an operator at a shell
	# has nobody waiting on an id and mints one.
	RUN_ID=$REQUESTED_RUN_ID
	if [ -z "$RUN_ID" ]; then
		RUN_ID=$(new_run_id)
	fi
	RUN_FROM=$(get_var REMIT_TAG)
	RUN_TARGET=$_target
	RUN_STARTED=$(iso_now)
	# What comes back once the gate has spoken. Normally exactly what was running
	# when the run started, so a service the operator had stopped stays stopped.
	# A box that was already down has nothing running to hold back, and restoring
	# nothing would leave it on the gate set alone — queue and backend up, the
	# origin refusing connections, and the run reporting success. The always-on
	# stack is where the same command used to leave that box, so that is what is
	# recorded instead.
	RUN_SERVICES=$(running_services)
	if [ -z "$RUN_SERVICES" ]; then
		RUN_SERVICES=$(all_services)
	fi
	RUN_MIGRATE_BEFORE=""
	mkdir -p "$STATE_DIR"

	phase checking "Preparing to update from $RUN_FROM to $_target." "remit status"

	# Nothing running is touched by the pull, so a failure here — a registry
	# refusal, a rate limit, a full disk — aborts having changed nothing and a
	# retry is safe.
	phase pulling "Downloading $_target." "remit logs"
	REMIT_TAG=$_target
	export REMIT_TAG
	if ! (pull_images); then
		REMIT_TAG=$RUN_FROM
		export REMIT_TAG
		terminate abandoned \
			"$_target could not be downloaded, so nothing was changed and this instance is still running $RUN_FROM." \
			"remit update"
		rm -rf "$STATE_DIR/snapshots/$RUN_ID"
		return 1
	fi

	# Against the live databases, before anything is stopped. A copy taken after
	# the stop silently drops every transaction still in the write-ahead log,
	# and the restore looks clean.
	phase snapshotting "Taking a snapshot of the database." "remit status"
	if ! snapshot_databases "$RUN_ID"; then
		REMIT_TAG=$RUN_FROM
		export REMIT_TAG
		terminate abandoned \
			"The database could not be snapshotted, so nothing was changed and this instance is still running $RUN_FROM." \
			"remit status"
		rm -rf "$STATE_DIR/snapshots/$RUN_ID"
		return 1
	fi

	# Before the stop, never at commit. If the updater dies and the host
	# reboots, the restart policy has to bring up binaries that match the
	# migrated database.
	set_var REMIT_TAG "$_target"

	phase stopping "Stopping services." "remit status"
	stop_everything

	phase starting "Starting $_target." "remit logs backend"
	start_gate_set

	phase verifying "Waiting for $_target to answer." "remit logs backend"
	if run_gate "$RUN_MIGRATE_BEFORE"; then
		commit_run
		return 0
	fi
	roll_back "$GATE_REASON"
}

# --- recovery (RFC 037 D6a, R11) --------------------------------------------
#
# Run at the updater's start. A breadcrumb with no terminal outcome means the
# updater died mid-run, and the answer is neither to resume nor to sit still. It
# branches on the recorded phase first and only then consults the gate, because
# a bare gate re-run reaches two wrong verdicts: before the stop the old version
# is still up and healthy, so the gate passes and success is reported for a
# version that was never installed; and after a restore during a rollback the
# stack may be up on the new tag against the reverted database, so a passing
# /health commits an update that was deliberately undone.
recover_run() {
	if [ ! -f "$STATE_DIR/breadcrumb" ]; then
		printf 'No interrupted update to recover.\n'
		return 0
	fi
	RUN_ID=$(breadcrumb_get runId)
	RUN_FROM=$(breadcrumb_get fromVersion)
	RUN_TARGET=$(breadcrumb_get targetVersion)
	RUN_STARTED=$(breadcrumb_get startedAt)
	RUN_SERVICES=$(breadcrumb_get services)
	RUN_MIGRATE_BEFORE=$(breadcrumb_get migrateBefore)
	_was=$(breadcrumb_get phase)

	case "$_was" in
	checking | pulling | snapshotting)
		RUN_PHASE=recovering
		terminate abandoned \
			"The update to $RUN_TARGET was interrupted before anything was changed; this instance is still running $RUN_FROM." \
			"remit status"
		rm -rf "$STATE_DIR/snapshots/$RUN_ID"
		;;
	stopping | starting | verifying)
		phase verifying "Checking whether $RUN_TARGET came up after an interrupted update." "remit logs backend"
		# A fresh `compose up` here is what re-reads .env: `unless-stopped` does
		# not restart containers that were explicitly stopped, so a host reboot
		# between the stop and the start leaves the app plane down until this.
		start_gate_set
		if run_gate "$RUN_MIGRATE_BEFORE"; then
			commit_run
			return 0
		fi
		roll_back "$GATE_REASON"
		;;
	committing)
		# The gate has already passed by this phase, so the only legal outcome is
		# succeeded. The migration is applied and the snapshot beside it is older
		# than everything the instance has served since the verdict; restoring it
		# would destroy those writes, whatever a second gate says about how the
		# stack is doing now. Bringing the app plane back up is all that is left.
		phase committing "Finishing the update to $RUN_TARGET." "remit logs backend"
		# shellcheck disable=SC2086 # GATE_SET is a service list, split on purpose
		compose up -d $GATE_SET
		commit_run
		;;
	rollingBack)
		# The only legal outcomes here are rolledBack and rollbackFailed,
		# whatever the gate says.
		roll_back "the update to $RUN_TARGET was interrupted while rolling back"
		;;
	*)
		RUN_PHASE=recovering
		terminate abandoned \
			"An interrupted update was found in an unknown state and abandoned; this instance is running $(get_var REMIT_TAG)." \
			"remit status"
		;;
	esac
}

# --- the command ------------------------------------------------------------

# The legacy path, and still the right one: on a box with no database on its
# volume there is no old version to snapshot, nothing to hold down and nothing
# to roll back to. install.sh's first `remit update` lands here.
plain_update() {
	_tag=$1
	# The tag reaches .env only once its images are on the box. Writing it
	# first leaves .env naming a version that failed to pull, which is then
	# what the next `up` — or the next operator reading it — believes is
	# running. Compose reads the exported value ahead of the .env one, so the
	# pull is already the new tag's.
	if [ -n "$_tag" ]; then
		REMIT_TAG=$_tag
		export REMIT_TAG
	fi
	pull_images
	if [ -n "$_tag" ]; then
		set_var REMIT_TAG "$_tag"
	fi
	apply
	if [ "${REMIT_QUIET:-0}" != "1" ]; then
		printf '\n'
		report_serving
		printf 'Running tag %s.\n' "$(get_var REMIT_TAG)"
	fi
}

cmd_update() {
	_tag=""
	_mode=update
	while [ $# -gt 0 ]; do
		case "$1" in
		--tag)
			[ $# -ge 2 ] || die "update: --tag needs a value"
			_tag=$2
			tag_valid "$_tag" || die "update: '$_tag' is not a usable image tag"
			shift 2
			;;
		--check)
			_mode=check
			shift
			;;
		--recover)
			_mode=recover
			shift
			;;
		--preflight)
			_mode=preflight
			shift
			;;
		*) die "update: unknown option '$1'" ;;
		esac
	done

	# The updater runs this at boot before it touches the stack: if its mount is
	# not the deployment directory's host path, driving compose would corrupt host
	# files (reader#272), so record the failure where the app renders it and
	# refuse. Runs before require_deployment because a broken mount is exactly the
	# case where the compose file may not be where it is expected.
	if [ "$_mode" = "preflight" ]; then
		mkdir -p "$STATE_DIR"
		if assert_bind_identity; then
			return 0
		fi
		check_failed "The updater is not mounted at the deployment directory's host path, so an update would corrupt host files (reader#272). Set REMIT_DEPLOY_DIR in .env to this directory's absolute path and recreate the stack — re-running install.sh does both."
		return 1
	fi

	require_deployment

	if [ "$_mode" = "recover" ]; then
		lock_acquire
		recover_run
		verify_updater_handoff
		return 0
	fi

	do_check || true

	if [ "$_mode" = "check" ]; then
		report_check "$(cat "$STATE_DIR/check.json" 2>/dev/null || true)"
		return 0
	fi

	lock_acquire

	if [ -z "$_tag" ] && [ -f "$CONTROL_DIR/request.json" ]; then
		_raw_request=$(cat "$CONTROL_DIR/request.json" 2>/dev/null || true)
		_refusal=0
		_request=$(requested_target) || _refusal=$?
		# Consumed either way: a request that was refused must not be retried on
		# every later run, and one that was taken is now the run's business.
		rm -f "$CONTROL_DIR/request.json"
		if [ "$_refusal" = "2" ]; then
			discard_expired_request "$_raw_request"
			return 1
		fi
		if [ -z "$_request" ]; then
			die "update: the update request on the control volume was rejected and discarded — it was oversized, carried a field other than a target version, named an unusable run id, or did not name the published release"
		fi
		_tag=$(printf '%s\n' "$_request" | sed -n 1p)
		REQUESTED_RUN_ID=$(printf '%s\n' "$_request" | sed -n 2p)
	fi

	# A box with nothing running and no database on its volume has no old version
	# to snapshot, nothing to hold down and nothing to roll back to, so it takes
	# the plain path — this is install.sh's first `remit update`, and it is also
	# why a manifest version is never adopted silently on a fresh install. Data is
	# what decides it, not processes: after a `remit down` the databases are still
	# there, and an update taken from that box migrates them, so it is driven the
	# same way a live one is. The stack comes up for the gate as part of that,
	# because a migration nobody watched is exactly what the gate is for.
	#
	# A probe that could not run has not said which of the two this box is, and
	# either guess is wrong, so the update stops here having changed nothing.
	if ! stack_is_running; then
		_data=0
		deployment_data_state || _data=$?
		if [ "$_data" = "2" ]; then
			die "update: the database volume could not be read, so whether this box holds data to protect is unknown and nothing was changed. Check that the docker daemon is responding and that $HELPER_IMAGE can be pulled, then run '$PROG update' again."
		fi
		if [ "$_data" = "1" ]; then
			plain_update "$_tag"
			return 0
		fi
	fi

	if [ -z "$_tag" ] && [ "$CHECK_AVAILABLE" = "true" ]; then
		_tag=$CHECK_VERSION
	fi
	if [ -z "$_tag" ]; then
		if [ -n "$(manifest_url)" ]; then
			report_check "$(cat "$STATE_DIR/check.json" 2>/dev/null || true)"
			return 0
		fi
		plain_update ""
		return 0
	fi

	run_update "$_tag"
}

# Where the record `remit status` renders comes from. install.sh's first update
# is the only one that ever runs in the operator's shell, so the copy it leaves
# beside .env is an install-time snapshot; every run after it happens in the
# updater container, whose STATE_DIR is the updater_state volume. Nothing writes
# the directory copy again, so a shell that reads it reports the install forever
# while the app reports the run that actually happened (reader#573). The volume
# is the record wherever there is one; the directory answers only for a
# deployment that has no updater volume at all.
#
# The two flat files, never the composed control/state.json: the check block and
# the run block there repeat the field names json_string matches, so a read of
# the document returns whichever of the two sed reached first.
UPDATE_CHECK_JSON=""
UPDATE_RUN_JSON=""
UPDATE_RECORD_UNREADABLE=""

# Inside the updater STATE_DIR is the volume itself, and a deployment with no
# updater volume has nowhere else its record could be.
state_dir_is_record() {
	[ -z "${REMIT_UPDATE_STATE_DIR:-}" ] || return 0
	! docker volume inspect "$(updater_state_volume)" >/dev/null 2>&1
}

read_update_record() {
	UPDATE_CHECK_JSON=""
	UPDATE_RUN_JSON=""
	UPDATE_RECORD_UNREADABLE=""
	if state_dir_is_record; then
		[ ! -f "$STATE_DIR/check.json" ] || UPDATE_CHECK_JSON=$(cat "$STATE_DIR/check.json")
		[ ! -f "$STATE_DIR/run.json" ] || UPDATE_RUN_JSON=$(cat "$STATE_DIR/run.json")
		return 0
	fi
	UPDATE_CHECK_JSON=$(updater_state_file check.json) || UPDATE_RECORD_UNREADABLE=1
	UPDATE_RUN_JSON=$(updater_state_file run.json) || UPDATE_RECORD_UNREADABLE=1
	return 0
}

report_check() {
	_c=$1
	if [ -z "$_c" ]; then
		printf 'Updates:   never checked — run '\''remit update --check'\''\n'
		return 0
	fi
	case "$(json_string "$_c" status)" in
	disabled)
		printf 'Updates:   not configured (REMIT_UPDATE_MANIFEST_URL is unset)\n'
		;;
	failed)
		printf 'Updates:   check failed — %s\n' "$(json_string "$_c" error)"
		;;
	*)
		if [ "$(json_bool "$_c" updateAvailable)" = "true" ]; then
			printf 'Updates:   %s is available — %s\n' \
				"$(json_string "$_c" latestVersion)" "$(json_string "$_c" summary)"
			printf "           Install it with: remit update\n"
		else
			printf 'Updates:   up to date (%s, checked %s)\n' \
				"$(json_string "$_c" latestVersion)" "$(json_string "$_c" lastCheckedAt)"
		fi
		;;
	esac
}

# The last run, as a sentence. message and logCommand are the same strings the
# app renders, so a shell and a browser never tell the operator two stories.
report_last_run() {
	_r=$1
	[ -n "$_r" ] || return 0
	_outcome=$(json_string "$_r" outcome)
	if [ -z "$_outcome" ]; then
		printf 'Update:    in progress (%s) — %s\n' \
			"$(json_string "$_r" phase)" "$(json_string "$_r" message)"
	else
		printf 'Update:    %s — %s\n' "$_outcome" "$(json_string "$_r" message)"
	fi
	printf '           %s\n' "$(json_string "$_r" logCommand)"
}

cmd_down() {
	require_deployment
	_profiled=$(running_profile_services)
	# stop, never `down`: the sqlite_data and message_storage volumes hold every
	# account, credential and message body on this box. All profiles, or the
	# line below claims nothing is served while an optional UI keeps serving.
	compose_all stop
	_origin=$(get_var PUBLIC_ORIGIN 2>/dev/null || true)
	if [ -n "$_origin" ]; then
		printf "remit is stopped: %s serves nothing until 'remit restart'.\n" "$_origin"
	else
		printf "remit is stopped: nothing is served until 'remit restart'.\n"
	fi
	printf "No data was removed — accounts, mail and settings come back with it.\n"
	# `remit restart` starts the always-on services. Anything behind a profile
	# was turned on by an explicit command and comes back the same way, so name
	# it here rather than leaving the operator to find it stopped later.
	#
	# Stopping is the contract of this command, so the hold record goes with it:
	# a `restart` killed before it restored must not have `remit down` followed
	# by `remit restart` quietly undo the stop the operator asked for.
	profile_hold_write ""
	if [ -n "$_profiled" ]; then
		printf "\nAlso stopped, and not started by 'remit restart':\n"
		profile_recovery_hint "$_profiled"
	fi
}

# What each volume costs the operator, for the purge confirmation. A name with
# no entry here still gets listed, labelled as undescribed: the list is derived
# from the compose file so that a volume added later cannot go missing from the
# message an operator reads at the moment they confirm destroying their data.
volume_purpose() {
	case "$1" in
	sqlite_data) printf 'every account, message index, tag and setting' ;;
	message_storage) printf 'the cached message bodies' ;;
	queue_data) printf 'work still queued' ;;
	caddy_data) printf 'the TLS certificates, including the internal root CA' ;;
	caddy_config) printf "caddy's own state" ;;
	updater_state) printf 'the update run log and the pre-update snapshots' ;;
	updater_control) printf 'the backend/updater request seam' ;;
	victoriametrics_data) printf 'the metrics history, if you ran the observability profile' ;;
	*) printf 'added after this message was written — see %s' "$COMPOSE_FILE" ;;
	esac
}

# Every volume the project declares, all profiles. An empty list would be a
# confirmation prompt that understates what it is about to destroy, so it is a
# failure rather than an empty section.
purge_volume_list() {
	_vols=$(compose_all config --volumes 2>/dev/null | grep -v '^[[:space:]]*$' || true)
	[ -n "$_vols" ] ||
		die "cannot read the volume list from $COMPOSE_FILE — refusing to ask you to confirm a purge without showing what it destroys"
	printf '%s\n' "$_vols" | while IFS= read -r _v; do
		printf '  %-21s %s\n' "$_v" "$(volume_purpose "$_v")"
	done
}

# The one destructive command. --yes is the confirmation: the wrapper has to
# work under `curl | bash`-style non-interactive use, so it never reads stdin.
cmd_purge() {
	require_deployment
	_yes=0
	while [ $# -gt 0 ]; do
		case "$1" in
		--yes)
			_yes=1
			shift
			;;
		*) die "purge: unknown option '$1'" ;;
		esac
	done
	if [ "$_yes" != "1" ]; then
		cat >&2 <<EOF
purge would destroy this deployment's data. Nothing has been touched.

It removes every container and network, and these volumes:

EOF
		purge_volume_list >&2
		cat >&2 <<EOF

Your accounts and everything you have organised in the app are gone with
sqlite_data and do not come back. Message bodies do: they are a cache of IMAP,
which is the source of truth, so they re-sync once an account is added again.

The install directory is left alone, .env and its FAKE_KMS_DATAKEY included:
  $REMIT_DIR
So 'remit restart' afterwards brings up an empty but working stack.

Those volumes belong to the host, not to that directory: they are named after
this deployment's Compose project, so any other install directory carrying that
same project name loses its data here too.

To stop serving without destroying anything, use 'remit down'.
Run 'remit purge --yes' if this is what you want.
EOF
		exit 1
	fi
	# All profiles: without it the optional containers survive the command whose
	# whole contract is that nothing is left, dozzle keeps the docker socket
	# under restart: unless-stopped, its volume keeps the per-account series, and
	# the network cannot be removed because something is still on it.
	compose_all down -v --remove-orphans
	# Nothing survives this, so a record of what to bring back is a record of
	# containers that no longer exist.
	profile_hold_write ""
	printf "\nremit is purged. %s/.env and the compose files are untouched;\n" "$REMIT_DIR"
	printf "'remit restart' brings up an empty stack.\n"
}

# The root CA only exists in internal mode, and only on the caddy volume: the
# first thing an internal-mode operator has to do is get it off the box, so it
# is a command rather than a compose invocation to copy out of the docs.
cmd_cert() {
	require_deployment
	[ $# -eq 0 ] || die "cert: unknown option '$1'"
	_mode=$(get_var TLS_MODE)
	if [ "$_mode" != "internal" ]; then
		die "TLS_MODE is '$_mode', which has no root CA to export.
Only TLS_MODE=internal signs with Caddy's own CA. Under 'acme' and 'tailscale'
the certificate is already publicly trusted, and 'off' serves plain HTTP."
	fi
	_dest="$PWD/reader-root.crt"
	# Checked separately, because `compose cp` reports an unwritable destination
	# and an absent container the same way, and the message below names only one.
	[ -w "$PWD" ] ||
		die "cannot write to $PWD — run 'remit cert' from a directory you own."
	compose cp caddy:/data/caddy/pki/authorities/local/root.crt "$_dest" ||
		die "could not read the root CA from the caddy container.
Caddy generates it on its first start in internal mode — check 'remit status'
shows caddy running, then try again."
	printf 'Root CA written to %s\n\n' "$_dest"
	printf 'Import it into the trust store of every machine you browse from:\n'
	printf '  macOS    Keychain Access, then mark it "Always Trust"\n'
	printf '  Windows  certlm.msc, Trusted Root Certification Authorities\n'
	printf '  Linux    /usr/local/share/ca-certificates + update-ca-certificates\n'
	printf '  Firefox  Settings, Certificates, View Certificates, Authorities\n'
}

# Redaction keys off what a name says the value is, not off a list of known
# secrets: a list prints whatever secret is added to the template next in the
# clear, and MSOAUTH_CLIENT_SECRET and the RCLONE_* backup keys are already in
# there. compose honours `export K=` and indented keys alike, so the name is
# matched after stripping either.
cmd_config() {
	require_deployment
	if [ "${1:-}" = "save" ]; then
		shift
		cmd_config_save "$@"
		return
	fi
	[ $# -eq 0 ] || die "config: unknown argument '$1'"
	awk '
		/^[ \t]*#/ { next }
		/^[ \t]*$/ { next }
		{
			line = $0
			sub(/^[ \t]+/, "", line)
			sub(/^export[ \t]+/, "", line)
			eq = index(line, "=")
			if (eq == 0) next
			k = substr(line, 1, eq - 1)
			v = substr(line, eq + 1)
			if (v == "") { print k "="; next }
			if (k ~ /SECRET|PASSWORD|TOKEN|DATAKEY|ACCESS_KEY|PRIVATE_KEY|CREDENTIAL/) {
				v = "<redacted>"
			} else if (v ~ /:\/\/[^\/@]*@/) {
				# Greedy to the last @: a password may contain one, and
				# stopping at the first prints its tail in the clear.
				sub(/:\/\/.*@/, "://<redacted>@", v)
			}
			print k "=" v
		}
	' "$REMIT_DIR/.env"
}

# `remit config save <file> [--user <email>]` (issue #1021).
#
# The document is built inside the backend image, over the same reader the
# export endpoint uses, and comes back on stdout. It is redirected to a host
# path here rather than written inside a container: the file exists to outlive
# the deployment it describes, and this way it lands owned by whoever ran the
# command instead of root-owned inside a volume.
#
# --no-deps is load-bearing for the reason check-categories has it: `compose
# run` would otherwise start the service's dependencies, and volume-init chowns
# the data volumes as root — writes, from a command that only reads.
#
# Written beside the target and renamed, so an export that dies half way through
# leaves nothing that looks like a configuration file.
#
# Exit 0 is not enough to rename on. The composition this entrypoint builds logs
# to stdout, and `compose run` merges a container's streams, so one stray line
# lands in the middle of the document and the command still succeeds. This file
# is the safety net an operator takes before dropping their database, and a
# corrupt one is worse than none: it is only discovered on the import that needed
# it. Same document-closed test `remit doctor` applies to the checker's JSON, for
# the same reason.
cmd_config_save() {
	_file=""
	_user=""
	while [ $# -gt 0 ]; do
		case "$1" in
		--user)
			[ $# -ge 2 ] || die "config save: --user needs an email address"
			_user=$2
			shift 2
			;;
		-*) die "config save: unknown option '$1'" ;;
		*)
			[ -z "$_file" ] || die "config save: takes one file"
			_file=$1
			shift
			;;
		esac
	done
	[ -n "$_file" ] ||
		die "config save: needs a file to write, e.g. '$PROG config save reader-config.json'"

	_dir=$(dirname "$_file")
	[ -d "$_dir" ] || die "config save: there is no directory '$_dir'"
	_tmp="$_dir/.$(basename "$_file").writing.$$"

	_rc=0
	if [ -n "$_user" ]; then
		compose run --rm --no-deps -T migrate \
			node config-save.mjs --user "$_user" >"$_tmp" || _rc=$?
	else
		compose run --rm --no-deps -T migrate \
			node config-save.mjs >"$_tmp" || _rc=$?
	fi
	if [ "$_rc" != "0" ]; then
		rm -f "$_tmp"
		die "config save: the export did not finish, so nothing was written"
	fi
	if ! doctor_json_closed "$_tmp"; then
		rm -f "$_tmp"
		die "config save: what came back is not a closed JSON document, so nothing was written — '$PROG logs backend' may say why"
	fi

	mv "$_tmp" "$_file"
	printf 'Wrote %s.\n' "$_file"
	printf 'It carries no password and no OAuth token — importing it asks for each account again.\n'
}

# The migrate entrypoint's read-only mode. --no-deps is load-bearing: without it
# `compose run` starts the service's dependencies, which means volume-init
# chowning the data volumes as root — writes, from a command whose whole promise
# is that it does not write. The one-shot's image is the backend image, already
# pulled, so nothing else is needed.
cmd_check_categories() {
	require_deployment
	[ $# -eq 0 ] || die "check-categories: takes no arguments"
	compose run --rm --no-deps migrate node migrate.mjs --check
}

# --- doctor (docs/design/standalone-observability.md D4) --------------------
#
# The verdict is computed in the `doctor` container and nowhere else. The
# signals behind it are on the compose network and this is a POSIX shell script
# whose only tool is docker, so this command scrapes nothing and decides
# nothing: it execs the checker, prints what comes back verbatim, and carries
# its exit code out.
#
# One fresh check per invocation. Not the alerting loop's last verdict — that
# is the settled one the dwell rule announces, deliberately up to three checks
# behind what is true now, and "is anything wrong" is a question about now.
DOCTOR_SERVICE=doctor

# A ceiling on the exec, for the same reason every helper `docker run` has one
# (reader#284): the checker bounds its own scrapes, and nothing bounds the
# docker CLI in front of it. An uncapped exec against a wedged daemon prints
# nothing and never returns, which defeats D4 as thoroughly as answering
# `healthy` would — and behind the README's `*/5` cron line it stacks a new
# process every five minutes. Set above the checker's own scrape budget so a
# slow check is never cut off; what this catches is a docker that has stopped
# answering at all.
DOCTOR_RUN_TIMEOUT="${REMIT_DOCTOR_TIMEOUT:-90}"

# timeout(1) needs a real command and `compose` is a shell function, so the
# capped call spells the argv out. It is the same invocation; the duplication is
# the price of the ceiling.
doctor_exec() {
	capped_run "$DOCTOR_RUN_TIMEOUT" docker compose \
		--project-directory "$REMIT_DIR" \
		-f "$REMIT_DIR/$COMPOSE_FILE" \
		--env-file "$REMIT_DIR/.env" \
		exec -T "$DOCTOR_SERVICE" node check.mjs "$@"
}

# The verdict's value, out of whichever rendering was asked for, or nothing.
# The value is what decides; whether the field is merely present decides
# nothing, because a truncated document and a container that printed half a
# line both have the field.
doctor_verdict() {
	if [ "$1" = "1" ]; then
		sed -n 's/.*"verdict"[[:space:]]*:[[:space:]]*"\([^"]*\)".*/\1/p' "$2" | head -n 1
	else
		sed -n 's/^verdict \(.*\)$/\1/p' "$2" | head -n 1
	fi
}

# A JSON document that did not finish arriving. `--json` exists for a caller
# piping into jq, and a half-written object satisfies any test for the field it
# happens to start with: the checker writes stdout and then exits, which drops a
# pending write when stdout is a pipe, and `compose exec -T` makes it one. The
# verdict long enough to fill that buffer is the degraded one worth reading, so
# the document has to open and close before anything in it is trusted.
doctor_json_closed() {
	[ "$(awk 'NF { print; exit }' "$1")" = "{" ] &&
		[ "$(awk 'NF { _l = $0 } END { print _l }' "$1")" = "}" ]
}

# What docker said, cut to its first non-empty line with control characters
# removed. The line format is one record per line and a JSON string carries no
# raw newline, so a multi-line complaint is cut rather than escaped into
# either; its first line is the part that names the cause.
doctor_first_line() {
	awk 'NF { print; exit }' "$1" 2>/dev/null | tr -d '[:cntrl:]'
}

# A check that could not look reports `degraded`, never healthy and never a
# stack trace: an exec that does not answer is itself the finding. Rendered in
# the checker's own two formats, so a caller parsing either does not have to
# special-case the one answer it most needs to read. The exit code is what
# separates this from a verdict the checker produced.
doctor_no_verdict() {
	_summary="remit is degraded: the health checker produced no verdict"
	_why="no usable verdict came back from the doctor container, so nothing about this stack was checked"
	if [ "$1" = "1" ]; then
		if [ -n "$2" ]; then
			_detail=$(printf '"%s"' "$(json_escape "$2")")
		else
			_detail=null
		fi
		printf '{\n  "verdict": "degraded",\n  "checkedAt": "%s",\n  "summary": "%s",\n  "reasons": [\n    {\n      "code": "checker_unreachable",\n      "summary": "%s",\n      "detail": %s\n    }\n  ]\n}\n' \
			"$(iso_now)" "$_summary" "$_why" "$_detail"
		return 0
	fi
	printf 'verdict degraded\n'
	printf 'checked-at %s\n' "$(iso_now)"
	printf 'summary %s\n' "$_summary"
	printf 'reason checker_unreachable %s\n' "$_why"
	if [ -n "$2" ]; then
		printf 'detail checker_unreachable %s\n' "$2"
	fi
}

cmd_doctor() {
	require_deployment
	_json=0
	while [ $# -gt 0 ]; do
		case "$1" in
		--json) _json=1 ;;
		*) die "doctor: unknown option '$1'" ;;
		esac
		shift
	done

	_out=$(mktemp) || die "doctor: cannot create a temporary file for the verdict"
	_err=$(mktemp) || die "doctor: cannot create a temporary file for the log"
	_rc=0
	if [ "$_json" = "1" ]; then
		doctor_exec --json >"$_out" 2>"$_err" || _rc=$?
	else
		doctor_exec >"$_out" 2>"$_err" || _rc=$?
	fi
	# The checker logs to stderr precisely so a log line cannot corrupt what is
	# parsed on stdout, and docker's own complaints arrive the same way. Both
	# belong in front of the operator; neither belongs in the verdict.
	cat "$_err" >&2

	# The verdict on stdout and the exit code the exec came back with have to be
	# the same answer, or there is no answer. `verdict degraded` from an exec
	# that exited 0 is the case that matters: the operator reads degraded while
	# `remit doctor || alert` never fires, and the exit code is the whole reason
	# this command exists. A value outside the closed vocabulary, a JSON document
	# that did not close, and an exec that died some other way after printing all
	# land in the same place — each is a reason to stop trusting the output
	# rather than a reason to print it.
	_verdict=$(doctor_verdict "$_json" "$_out")
	_expected=""
	case "$_verdict" in
	healthy) _expected=0 ;;
	degraded) _expected=1 ;;
	esac
	if [ -n "$_expected" ] && [ "$_expected" = "$_rc" ] &&
		{ [ "$_json" = "0" ] || doctor_json_closed "$_out"; }; then
		cat "$_out"
		rm -f "$_out" "$_err"
		exit "$_rc"
	fi

	# Which of the three it was. The operator reading this has an exit code that
	# says "no verdict" and needs to know whether the container is missing, the
	# daemon is wedged, or the answer arrived and could not be trusted.
	_detail=$(doctor_first_line "$_err")
	if [ "$_rc" = "124" ] && have timeout; then
		_detail="'compose exec' did not answer within ${DOCTOR_RUN_TIMEOUT}s"
	elif [ -z "$_expected" ] && [ -n "$_verdict" ]; then
		_detail="the checker printed a verdict this wrapper does not know: '$_verdict'"
	elif [ -n "$_expected" ] && [ "$_expected" != "$_rc" ]; then
		_detail="the checker printed the verdict '$_verdict' and exited $_rc"
	elif [ -n "$_expected" ]; then
		_detail="the checker's JSON document did not close — it arrived truncated"
	fi
	rm -f "$_out" "$_err"
	doctor_no_verdict "$_json" "$_detail"
	# The hint goes to stderr because stdout above is a closed vocabulary a
	# caller parses. `doctor` is an always-on service, not one of the optional
	# profiles, so getting it back is a plain restart of the stack.
	printf "%s: '%s status' shows what is running and '%s logs %s' what the checker said.\n" \
		"$PROG" "$PROG" "$PROG" "$DOCTOR_SERVICE" >&2
	printf "The '%s' service is part of the stack, not behind a profile, so '%s restart' starts it.\n" \
		"$DOCTOR_SERVICE" "$PROG" >&2
	exit 2
}

main() {
	[ $# -gt 0 ] || {
		usage >&2
		exit 2
	}
	_cmd=$1
	shift
	case "$_cmd" in
	restart) cmd_restart "$@" ;;
	logs) cmd_logs "$@" ;;
	status) cmd_status "$@" ;;
	update) cmd_update "$@" ;;
	down) cmd_down "$@" ;;
	purge) cmd_purge "$@" ;;
	doctor) cmd_doctor "$@" ;;
	config) cmd_config "$@" ;;
	check-categories) cmd_check_categories "$@" ;;
	cert) cmd_cert "$@" ;;
	probe-host)
		[ $# -eq 1 ] || die "probe-host: needs one origin or hostname"
		probe_host "$1"
		;;
	help | --help | -h) usage ;;
	*)
		printf '%s: unknown command '\''%s'\''\n\n' "$PROG" "$_cmd" >&2
		usage >&2
		exit 2
		;;
	esac
}

# $REMIT_LIB_ONLY lets the test suite source this file and exercise one function
# at a time. It is the only reason it exists; nothing in the deployment sets it.
if [ "${REMIT_LIB_ONLY:-0}" != "1" ]; then
	main "$@"
fi
