# Shared reverse-proxy routes, imported by the per-mode site file that
# TLS_MODE selects (docker-compose.yml). This is the only copy of the routing
# table; the mode files add nothing but the site address and TLS behaviour.
#
# Caddy is the only component that talks to the client, so it is the only one
# that knows the real peer, and it states that peer here for everything behind
# it. `{client_ip}` is the connection's remote address — Caddy trusts no proxy
# by default, so a client-supplied forwarded header never feeds it. This
# replaces any inbound copy of the header rather than appending to it.
#
# The address needs a header of its own because neither standard one survives
# the hop to the backend: apisix appends its own hop to X-Forwarded-For (the
# multi-hop value better-auth cannot resolve to one client) and overwrites
# X-Real-IP with the caddy container's address. Consumed by
# packages/auth-service (CLIENT_IP_HEADER).
request_header X-Remit-Client-IP {client_ip}

#
# Routing mirrors the dev vite proxy 1:1 (packages/web-client/vite.config.ts):
#   /api/auth/*  -> apisix, path unchanged (better-auth's own routes)
#   /api/*       -> apisix, with the /api prefix stripped (business routes,
#                   matching the openapi-generated apisix route table, which
#                   has no /api prefix)
#   /content/*   -> backend directly, path unchanged (signed-URL content
#                   delivery; not part of the openapi/JWT-gated surface, so
#                   it does not go through apisix's business routes)
#   everything else -> the web static server (the SPA and its assets)
#
# Every upstream here is a single-replica container a redeploy replaces in
# place: `docker compose up -d` stops the old container and starts the new one,
# and for the seconds in between the service name does not dial. Caddy stays up
# across that swap (it is not itself replaced), so without a retry window it
# turns each in-flight request into a 502 — the ~1s of "dial tcp: lookup apisix
# … server misbehaving" a routine redeploy dropped on background polls (#229,
# #225). `lb_try_duration` holds each request at the proxy and re-dials every
# `lb_try_interval` until the new container answers, so a routine redeploy
# serves the request instead of failing it. A dial failure means nothing was
# written upstream, so the retry is safe for every method, not only GETs, and
# the window is bounded: an upstream that stays down past it still errors, which
# is a real outage surfacing rather than a redeploy blip being hidden.
route /api/auth/* {
	reverse_proxy apisix:9080 {
		lb_try_duration 30s
		lb_try_interval 250ms
	}
}

route /api/* {
	uri strip_prefix /api
	reverse_proxy apisix:9080 {
		lb_try_duration 30s
		lb_try_interval 250ms
	}
}

route /content/* {
	reverse_proxy backend:8080 {
		lb_try_duration 30s
		lb_try_interval 250ms
	}
}

route /health {
	reverse_proxy apisix:9080 {
		lb_try_duration 30s
		lb_try_interval 250ms
	}
}

route {
	reverse_proxy web:8080 {
		lb_try_duration 30s
		lb_try_interval 250ms
	}
}
