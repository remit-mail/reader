# TLS_MODE=off (default) — plain HTTP on :80, the current behaviour.
# Reach this over a private network (a tailnet, a VPN, an SSH tunnel); there
# is no TLS here. PUBLIC_ORIGIN must be http://…
import /etc/caddy/routes.caddy

:80 {
	# The MCP connector's host first (routes.caddy), ahead of the catch-all.
	import mcp_route
	import routes
}
