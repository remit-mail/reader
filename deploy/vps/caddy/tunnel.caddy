# TLS_MODE=tunnel — TLS terminates at Cloudflare's edge. The `tunnel` compose
# service dials that edge outbound and holds the connection open; requests come
# back down it to this Caddy over the compose network, in plain HTTP. There is
# no certificate here and no name on the site address.
# PUBLIC_ORIGIN must be https://…
{
	servers {
		trusted_proxies static private_ranges
		trusted_proxies_strict
		client_ip_headers Cf-Connecting-Ip
	}
}

import /etc/caddy/routes.caddy
import /etc/caddy/mcp.caddy

:80 {
	# The MCP connector's host first (mcp.caddy), ahead of the catch-all.
	import mcp_route
	import routes
}
