namespace RemitImap;

@doc("Display color for a calendar collection. Positional rather than named: the palette is a client-side concern, so the store carries the slot and the client owns what it renders (issue #15).")
enum CalendarColor {
  Cal1: "Cal1",
  Cal2: "Cal2",
  Cal3: "Cal3",
  Cal4: "Cal4",
  Cal5: "Cal5",
  Cal6: "Cal6",
}
