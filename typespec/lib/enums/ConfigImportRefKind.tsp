namespace RemitImap;

@doc("Which piece of configuration a still-unbound folder reference belongs to. A mailbox id is regenerated by every discovery, so an imported file names folders by IMAP path and the binder writes the row once a path resolves.")
enum ConfigImportRefKind {
  @doc("A canonical role waiting for the folder appointed to it; `target` is the role")
  FolderRole: "FolderRole",

  @doc("A per-folder display name or mute waiting for its folder; `target` is the folder path")
  MailboxOverride: "MailboxOverride",

  @doc("A filter's move action waiting for its destination folder; `target` is the filter id")
  FilterAction: "FilterAction",
}
