# The engine's provenance, in one place. build.sh sources this, the Docker
# hunspell-wasm stage runs build.sh, and npm-scripts/build-hunspell.mjs reads it
# to start the same image locally.
HUNSPELL_VERSION=1.7.3
HUNSPELL_SHA256=433274dac0619cb00c2e18b43a3dd3a9d50da5b5613fa9b5c21781e35dd76bc1
EMSDK_IMAGE=docker.io/emscripten/emsdk:6.0.6

# What the engine may cost the writer who opens the first composer on a cold
# cache, brotli, because brotli is the only form the image stores or serves.
# Today's build is 187,169 and 15,332; the headroom absorbs a toolchain bump
# without absorbing a source list or a compiler flag that undoes -Oz. Every
# language shares these bytes, so they are the one part of the download nobody
# opts out of.
HUNSPELL_MAX_WASM_BROTLI_BYTES=205000
HUNSPELL_MAX_LOADER_BROTLI_BYTES=20000
