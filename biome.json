{
	"$schema": "https://biomejs.dev/schemas/2.5.4/schema.json",
	"plugins": [
		"./plugins/no-logger-info.grit",
		"./plugins/no-silent-catch.grit"
	],
	"vcs": {
		"enabled": true,
		"clientKind": "git",
		"useIgnoreFile": true
	},
	"files": {
		"ignoreUnknown": true,
		"includes": ["**/*.ts", "**/*.tsx", "**/*.js", "**/*.mjs"]
	},
	"formatter": {
		"enabled": true,
		"indentStyle": "tab"
	},
	"linter": {
		"enabled": true,
		"includes": [
			"**/*.ts",
			"**/*.tsx",
			"**/*.js",
			"**/*.mjs",
			"!**/routeTree.gen.ts"
		],
		"rules": {
			"recommended": true,
			"a11y": {
				"preset": "all"
			},
			"correctness": {
				"noUnusedPrivateClassMembers": "off"
			},
			"style": {
				"useFilenamingConvention": {
					"level": "error",
					"options": {
						"filenameCases": ["kebab-case", "PascalCase", "camelCase"]
					}
				}
			}
		}
	},
	"javascript": {
		"formatter": {
			"quoteStyle": "double"
		}
	},
	"assist": {
		"enabled": true,
		"actions": {
			"source": {
				"organizeImports": "on"
			}
		}
	},
	"overrides": [
		{
			"includes": [
				"packages/web-client/src/**/*.ts",
				"packages/web-client/src/**/*.tsx",
				"!packages/web-client/src/routes/**",
				"!packages/web-client/src/routing/**"
			],
			"linter": {
				"rules": {
					"style": {
						"noRestrictedImports": {
							"level": "warn",
							"options": {
								"paths": {
									"@tanstack/react-router": {
										"importNames": ["Link"],
										"message": "Use NavLink from @/routing: it carries the route table's own type inference, so an illegal route or param set fails to compile."
									}
								}
							}
						}
					}
				}
			}
		},
		{
			"includes": ["npm-scripts/lib/*.test.mjs"],
			"linter": {
				"rules": {
					"suspicious": {
						"noTemplateCurlyInString": "off"
					}
				}
			}
		}
	]
}
